{
  "schemaVersion": 1,
  "id": "vercel",
  "name": "Vercel",
  "description": "Vercel API",
  "format": "openai",
  "runtime": {
    "plugin": "vercel"
  },
  "baseUrl": "https://api.vercel.com/v1/",
  "env": [
    "VERCEL_API_KEY"
  ],
  "icon": "icon.svg",
  "website": "https://vercel.com/",
  "docsUrl": "https://vercel.com/docs",
  "sortOrder": 60,
  "enabled": true,
  "fields": [
    {
      "key": "apiKey",
      "type": "password",
      "label": "API Key",
      "required": true,
      "placeholder": "vercel_..."
    }
  ]
}
