{
  "schemaVersion": 1,
  "id": "openai",
  "name": "OpenAI",
  "description": "OpenAI API",
  "format": "openai",
  "runtime": {
    "plugin": "openai"
  },
  "baseUrl": "https://api.openai.com/v1/",
  "env": [
    "OPENAI_API_KEY"
  ],
  "icon": "icon.svg",
  "website": "https://platform.openai.com/",
  "docsUrl": "https://platform.openai.com/docs/",
  "sortOrder": 10,
  "enabled": true,
  "fields": [
    {
      "key": "apiKey",
      "type": "password",
      "label": "API Key",
      "required": true,
      "placeholder": "sk-..."
    }
  ]
}
