{
  "schemaVersion": 1,
  "id": "opencode-free",
  "name": "OpenCode Free",
  "description": "OpenCode 官方 Zen 网关免费档（匿名公开 token，模型列表会浮动）",
  "format": "openai",
  "runtime": {
    "plugin": "opencode-free"
  },
  "baseUrl": "https://opencode.ai/zen/v1",
  "headers": {
    "User-Agent": "opencode/1.18.31 ai-sdk/provider-utils/4.0.23 runtime/node.js/24",
    "x-session-id": "${session}",
    "x-session-affinity": "${session}"
  },
  "icon": "icon.svg",
  "website": "https://opencode.ai/",
  "docsUrl": "https://opencode.ai/docs",
  "sortOrder": 71,
  "enabled": true,
  "fields": [
    {
      "key": "apiKey",
      "type": "text",
      "label": "API Key",
      "required": false,
      "placeholder": "留空默认使用公开 token: public"
    }
  ]
}