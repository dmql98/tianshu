{
  "schemaVersion": 1,
  "id": "opencode-go",
  "name": "OpenCode Go",
  "description": "OpenCode Go API",
  "format": "openai",
  "runtime": {
    "plugin": "opencode-go"
  },
  "baseUrl": "https://opencode.ai/zen/go/v1/",
  "env": [
    "OPENCODE_API_KEY"
  ],
  "headers": {
    "User-Agent": "opencode/1.18.31 ai-sdk/provider-utils/4.0.23 runtime/node.js/24",
    "x-session-id": "${session}",
    "x-session-affinity": "${session}"
  },
  "icon": "icon.svg",
  "website": "https://opencode.ai/",
  "docsUrl": "https://opencode.ai/docs",
  "sortOrder": 70,
  "enabled": true,
  "fields": [
    {
      "key": "apiKey",
      "type": "password",
      "label": "API Key",
      "required": true,
      "placeholder": "oc_..."
    }
  ]
}
