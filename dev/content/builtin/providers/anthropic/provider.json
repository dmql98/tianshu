{
  "schemaVersion": 1,
  "id": "anthropic",
  "name": "Anthropic",
  "description": "Anthropic API",
  "format": "anthropic",
  "runtime": {
    "plugin": "anthropic"
  },
  "baseUrl": "https://api.anthropic.com/v1/",
  "env": [
    "ANTHROPIC_API_KEY"
  ],
  "icon": "icon.svg",
