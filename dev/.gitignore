# ── 天枢 dev/ 目录 .gitignore ──

# ── 依赖与构建产物 ──
node_modules/
dist/
build/
*.tsbuildinfo

# ── 桌面端构建产物（由 scripts/prepare-desktop-runtime.mjs 重新生成）──
/desktop/dist/
/desktop/release/
/desktop/runtime/
/desktop/staging/

# ── 数据库与数据文件 ──
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/*.db*
web/server/data/*.db*

# ── 运行时数据目录 ──
/devdata/
data/
web/server/data/
/web/server/data/bash-logs
/web/server/data/tool-output/
/web/server/data/debug/
/web/server/data/media/
/data/media
web/data/
/data/mcpservers
data/providers.json
web/server/data/providers.json

# ── 本地调试/性能产物 ──
.bench-*
.sse-*.txt
.analysis-scratch*/

# ── Playwright CLI 调试日志 ──
.playwright-cli/

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── 日志 ──
*.log

# ── 环境与密钥 ──
.env
.env.*
!.env.example
!.env.*.example

# ── 测试产物 ──
coverage/
test-results/
playwright-report/

# ── 编辑器 / 系统杂物 ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
