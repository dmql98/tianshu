            "content": "{\"output\":\"from app.pipeline.text_layer import TextRegion\\r\\n\\r\\n\\r\\ndef reading_order(regions: list[TextRegion]) -> list[TextRegion]:\\r\\n    return sorted(\\r\\n        regions,\\r\\n        key=lambda region: (\\r\\n            round(\\r\\n                (region.bbox.y + region.bbox.height / 2) / 0.04\\r\\n            ),\\r\\n            region.bbox.x + region.bbox.width / 2,\\r\\n        ),\\r\\n    )\",\"error\":\"\"}",
