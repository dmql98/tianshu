            "role": "tool",
            "content": "{\"output\":\"import re\\r\\nimport unicodedata\\r\\nfrom typing import Any\\r\\n\\r\\nfrom pydantic import BaseModel, ConfigDict, Field\\r\\n\\r\\n\\r\\nTHREAD_SPEC = re.compile(\\r\\n    r\\\"\\\\bM\\\\s*(?P<size>\\\\d+(?:\\\\.\\\\d+)?)\\\\s*-\\\\s*(?P<grade>\\\\d+[A-Z])\\\",\\r\\n    re.IGNORECASE,\\r\\n)\\r\\nDIAMETER = re.compile(r\\\"[⌀ØΦφ]\\\\s*(\\\\d+(?:\\\\.\\\\d+)?)\\\")\\r\\nDEPTH = re.compile(r\\\"深\\\\s*(\\\\d+(?:\\\\.\\\\d+)?)\\\")\\r\\n\\r\\n\\r\\nclass HoleTableRow(BaseModel):\\r\\n    model_config = ConfigDict(extra=\\\"forbid\\\")\\r\\n\\r\\n    label: str = Field(pattern=r\\\"^[A-HJ-L]$\\\")\\r\\n    raw_callout: str\\r\\n    quantity: int = Field(gt=0)\\r\\n    thread_spec: str | None = None\\r\\n    diameters: list[float]\\r\\n    depths: list[float]\\r\\n    is_through: bool\\r\\n    is_counterbore: bool\\r\\n    is_back_side: bool\\r\\n\\r\\n\\r\\ndef parse_hole_table(\\r\\n    regions: list[dict[str, Any]],\\r\\n) -> list[HoleTableRow]:\\r\\n    rows: list[HoleTableRow] = []\\r\\n    for region in regions:\\r\\n        label = str(region[\\\"label\\\"]).strip().upper()\\r\\n        callout = unicodedata.normalize(\\r\\n            \\\"NFKC\\\",\\r\\n            str(region[\\\"callout\\\"]),\\r\\n        )\\r\\n        match = THREAD_SPEC.search(callout)\\r\\n        thread_spec = (\\r\\n            f\\\"M{match.group('size')}-{match.group('grade').upper()}\\\"\\r\\n            if match\\r\\n            else None\\r\\n        )\\r\\n        rows.append(\\r\\n            HoleTableRow(\\r\\n                label=label,\\r\\n                raw_callout=callout,\\r\\n                quantity=int(region[\\\"quantity\\\"]),\\r\\n                thread_spec=thread_spec,\\r\\n                diameters=[\\r\\n                    float(value) for value in DIAMETER.findall(callout)\\r\\n                ],\\r\\n                depths=[float(value) for value in DEPTH.findall(callout)],\\r\\n                is_through=\\\"贯穿\\\" in callout,\\r\\n                is_counterbore=\\\"沉孔\\\" in callout,\\r\\n                is_back_side=\\\"背面\\\" in callout,\\r\\n            )\\r\\n        )\\r\\n\\r\\n    label_order = {label: index for index, label in enumerate(\\\"ABCDEFGHJKL\\\")}\\r\\n    return sorted(rows, key=lambda row: label_order[row.label])\",\"error\":\"\"}",
