            "role": "tool",
            "content": "{\"output\":\"import re\\r\\nimport unicodedata\\r\\n\\r\\nfrom pydantic import BaseModel, ConfigDict\\r\\n\\r\\nfrom app.domain.recognition import PointKind, ToleranceSource\\r\\n\\r\\n\\r\\nNUMBER = r\\\"(?:\\\\d+(?:\\\\.\\\\d+)?|\\\\.\\\\d+)\\\"\\r\\nPREFIX = r\\\"(?P<prefix>[⌀ØΦφ]?)\\\\s*\\\"\\r\\nSYMMETRIC_TOLERANCE = re.compile(\\r\\n    rf\\\"^{PREFIX}(?P<nominal>{NUMBER})\\\\s*±\\\\s*(?P<tolerance>{NUMBER})$\\\"\\r\\n)\\r\\nASYMMETRIC_TOLERANCE = re.compile(\\r\\n    rf\\\"^{PREFIX}(?P<nominal>{NUMBER})\\\\s+\\\"\\r\\n    rf\\\"(?P<upper>[+-]?{NUMBER}|0)\\\\s+\\\"\\r\\n    rf\\\"(?P<lower>[+-]?{NUMBER}|0)$\\\"\\r\\n)\\r\\nPLAIN_DIMENSION = re.compile(\\r\\n    rf\\\"^{PREFIX}(?P<nominal>{NUMBER})$\\\"\\r\\n)\\r\\n\\r\\n\\r\\nclass ParsedDimension(BaseModel):\\r\\n    model_config = ConfigDict(extra=\\\"forbid\\\")\\r\\n\\r\\n    raw_text: str\\r\\n    kind: PointKind\\r\\n    nominal_value: float\\r\\n    upper_deviation: float | None\\r\\n    lower_deviation: float | None\\r\\n    tolerance_source: ToleranceSource\\r\\n    unit: str = \\\"mm\\\"\\r\\n\\r\\n\\r\\ndef normalize_dimension_text(text: str) -> str:\\r\\n    normalized = unicodedata.normalize(\\\"NFKC\\\", text)\\r\\n    normalized = (\\r\\n        normalized.replace(\\\"＋\\\", \\\"+\\\")\\r\\n        .replace(\\\"－\\\", \\\"-\\\")\\r\\n        .replace(\\\"−\\\", \\\"-\\\")\\r\\n        .replace(\\\"∅\\\", \\\"⌀\\\")\\r\\n        .replace(\\\"ø\\\", \\\"⌀\\\")\\r\\n    )\\r\\n    return re.sub(r\\\"\\\\s+\\\", \\\" \\\", normalized).strip()\\r\\n\\r\\n\\r\\ndef parse_dimension(\\r\\n    text: str,\\r\\n    *,\\r\\n    tolerance_standard: str | None = None,\\r\\n) -> ParsedDimension:\\r\\n    normalized = normalize_dimension_text(text)\\r\\n    symmetric = SYMMETRIC_TOLERANCE.fullmatch(normalized)\\r\\n    if symmetric:\\r\\n        tolerance = float(symmetric.group(\\\"tolerance\\\"))\\r\\n        return _result(\\r\\n            normalized,\\r\\n            symmetric.group(\\\"prefix\\\"),\\r\\n            float(symmetric.group(\\\"nominal\\\")),\\r\\n            tolerance,\\r\\n            -tolerance,\\r\\n            ToleranceSource.DRAWING_EXPLICIT,\\r\\n        )\\r\\n\\r\\n    asymmetric = ASYMMETRIC_TOLERANCE.fullmatch(normalized)\\r\\n    if asymmetric:\\r\\n        return _result(\\r\\n            normalized,\\r\\n            asymmetric.group(\\\"prefix\\\"),\\r\\n            float(asymmetric.group(\\\"nominal\\\")),\\r\\n            float(asymmetric.group(\\\"upper\\\")),\\r\\n            float(asymmetric.group(\\\"lower\\\")),\\r\\n            ToleranceSource.DRAWING_EXPLICIT,\\r\\n        )\\r\\n\\r\\n    plain = PLAIN_DIMENSION.fullmatch(normalized)\\r\\n    if not plain:\\r\\n        raise ValueError(\\\"UNRECOGNIZED_DIMENSION\\\")\\r\\n\\r\\n    nominal = float(plain.group(\\\"nominal\\\"))\\r\\n    tolerance = _general_tolerance(nominal, tolerance_standard)\\r\\n    return _result(\\r\\n        normalized,\\r\\n        plain.group(\\\"prefix\\\"),\\r\\n        nominal,\\r\\n        tolerance,\\r\\n        -tolerance if tolerance is not None else None,\\r\\n        (\\r\\n            ToleranceSource.STANDARD_INFERRED\\r\\n            if tolerance is not None\\r\\n            else ToleranceSource.NONE\\r\\n        ),\\r\\n    )\\r\\n\\r\\n\\r\\ndef _result(\\r\\n    raw_text: str,\\r\\n    prefix: str,\\r\\n    nominal: float,\\r\\n    upper: float | None,\\r\\n    lower: float | None,\\r\\n    source: ToleranceSource,\\r\\n) -> ParsedDimension:\\r\\n    return ParsedDimension(\\r\\n        raw_text=raw_text,\\r\\n        kind=(\\r\\n            PointKind.DIAMETER\\r\\n            if prefix in {\\\"⌀\\\", \\\"Ø\\\", \\\"Φ\\\", \\\"φ\\\"}\\r\\n            else PointKind.LINEAR\\r\\n        ),\\r\\n        nominal_value=nominal,\\r\\n        upper_deviation=upper,\\r\\n        lower_deviation=lower,\\r\\n        tolerance_source=source,\\r\\n    )\\r\\n\\r\\n\\r\\ndef _general_tolerance(\\r\\n    nominal: float,\\r\\n    standard: str | None,\\r\\n) -> float | None:\\r\\n    if standard is None or standard.upper().replace(\\\" \\\", \\\"\\\") not in {\\r\\n        \\\"GB/T1804-M\\\",\\r\\n        \\\"GBT1804-M\\\",\\r\\n    }:\\r\\n        return None\\r\\n\\r\\n    for lower, upper, tolerance in (\\r\\n        (0.5, 3, 0.1),\\r\\n        (3, 6, 0.1),\\r\\n        (6, 30, 0.2),\\r\\n        (30, 120, 0.3),\\r\\n        (120, 400, 0.5),\\r\\n        (400, 1000, 0.8),\\r\\n        (1000, 2000, 1.2),\\r\\n        (2000, 4000, 2.0),\\r\\n    ):\\r\\n        if lower < nominal <= upper or nominal == lower == 0.5:\\r\\n            return tolerance\\r\\n    raise ValueError(\\\"DIMENSION_OUTSIDE_TOLERANCE_STANDARD\\\")\",\"error\":\"\"}",
            "tool_call_id": "call_00_RBPowoWp4nQFpnSDqLlp4002"
