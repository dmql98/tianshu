            "role": "tool",
            "content": "{\"output\":\"package com.industrial.scheduler;\\r\\n\\r\\nimport com.industrial.config.FlowEngineConfig;\\r\\nimport com.industrial.constant.FlowConstants;\\r\\nimport com.industrial.context.FlowExecutionContext;\\r\\nimport com.industrial.engine.FlowExecutionEngine;\\r\\nimport com.industrial.service.FlowService;\\r\\nimport com.industrial.util.ExecutorUtils;\\r\\nimport jakarta.annotation.PreDestroy;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport java.util.List;\\r\\nimport java.util.Map;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\nimport java.util.concurrent.ExecutorService;\\r\\n\\r\\n/**\\r\\n * 流程调度器\\r\\n * <p>\\r\\n * 负责流程的异步、同步、循环调度的统一入口\\r\\n */\\r\\n@Slf4j\\r\\n@Component\\r\\npublic class FlowScheduler {\\r\\n\\r\\n    private final FlowExecutionEngine executionEngine;\\r\\n    private final FlowService flowService;\\r\\n    private final FlowEngineConfig config;\\r\\n    private final ExecutorService schedulerExecutor;\\r\\n    private final Map<String, LoopExecutionThread> loopThreads = new ConcurrentHashMap<>();\\r\\n\\r\\n    public FlowScheduler(FlowExecutionEngine executionEngine,\\r\\n                        FlowService flowService,\\r\\n                        FlowEngineConfig config) {\\r\\n        this.executionEngine = executionEngine;\\r\\n        this.flowService = flowService;\\r\\n        this.config = config;\\r\\n\\r\\n        this.schedulerExecutor = ExecutorUtils.createDaemonThreadPool(\\r\\n                SchedulerConstants.SCHEDULER_CORE_POOL_SIZE,\\r\\n                SchedulerConstants.SCHEDULER_MAX_POOL_SIZE,\\r\\n                SchedulerConstants.SCHEDULER_KEEP_ALIVE_SECONDS,\\r\\n                SchedulerConstants.SCHEDULER_QUEUE_CAPACITY,\\r\\n                SchedulerConstants.SCHEDULER_THREAD_PREFIX\\r\\n        );\\r\\n    }\\r\\n\\r\\n    @PreDestroy\\r\\n    public void shutdown() {\\r\\n        log.info(\\\"关闭流程调度器...\\\");\\r\\n        stopAllLoopExecution();\\r\\n        ExecutorUtils.shutdownGracefully(schedulerExecutor, \\\"FlowScheduler\\\");\\r\\n        log.info(\\\"流程调度器已关闭\\\");\\r\\n    }\\r\\n\\r\\n    // ==================== 异步调度 ====================\\r\\n\\r\\n    public FlowExecutionContext scheduleAsync(String projectId, String flowId, Map<String, Object> inputs) {\\r\\n        return scheduleAsync(projectId, flowId, inputs, null);\\r\\n    }\\r\\n\\r\\n    public FlowExecutionContext scheduleAsync(String projectId, String flowId, Map<String, Object> inputs,\\r\\n                                              List<String> callChain) {\\r\\n        log.debug(\\\"异步触发流程: projectId={}, flowId={}, callChain={}\\\", projectId, flowId, callChain);\\r\\n        return executionEngine.executeAsync(projectId, flowId, FlowConstants.TRIGGER_TYPE_TRIGGER,\\r\\n                inputs, callChain, null);\\r\\n    }\\r\\n\\r\\n    // ==================== 同步调度 ====================\\r\\n\\r\\n    public FlowExecutionContext scheduleSync(String projectId, String flowId, Map<String, Object> inputs) {\\r\\n        return scheduleSync(projectId, flowId, inputs, null, null);\\r\\n    }\\r\\n\\r\\n    public FlowExecutionContext scheduleSync(String projectId, String flowId, Map<String, Object> inputs,\\r\\n                                             List<String> callChain) {\\r\\n        return scheduleSync(projectId, flowId, inputs, callChain, null);\\r\\n    }\\r\\n\\r\\n    public FlowExecutionContext scheduleSync(String projectId, String flowId, Map<String, Object> inputs,\\r\\n                                             List<String> callChain,\\r\\n                                             FlowExecutionContext parentContext) {\\r\\n        log.debug(\\\"同步调用流程: projectId={}, flowId={}, callChain={}, hasParentContext={}\\\",\\r\\n                projectId, flowId, callChain, parentContext != null);\\r\\n\\r\\n        if (parentContext != null) {\\r\\n            return executionEngine.executeSyncWithParent(projectId, flowId,\\r\\n                    FlowConstants.TRIGGER_TYPE_CALL, inputs, callChain, parentContext);\\r\\n        }\\r\\n        return executionEngine.executeSync(projectId, flowId,\\r\\n                FlowConstants.TRIGGER_TYPE_CALL, inputs, callChain);\\r\\n    }\\r\\n\\r\\n    // ==================== 循环调度 ====================\\r\\n\\r\\n    private FlowExecutionContext scheduleLoop(String projectId, String flowId, Map<String, Object> inputs) {\\r\\n        log.debug(\\\"调度循环流程: projectId={}, flowId={}\\\", projectId, flowId);\\r\\n        return executionEngine.executeAsync(projectId, flowId, FlowConstants.TRIGGER_TYPE_LOOP,\\r\\n                inputs, null, null);\\r\\n    }\\r\\n\\r\\n    // ==================== Loop Listener 控制 ====================\\r\\n\\r\\n    public void startLoopListener(String projectId) {\\r\\n        if (loopThreads.containsKey(projectId)) {\\r\\n            log.warn(\\\"项目 {} 的循环执行监听器已存在\\\", projectId);\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        LoopExecutionThread thread = new LoopExecutionThread(projectId, executionEngine, flowService, config);\\r\\n        loopThreads.put(projectId, thread);\\r\\n        thread.start();\\r\\n        log.info(\\\"项目 {} 的循环执行监听器已启动\\\", projectId);\\r\\n    }\\r\\n\\r\\n    public void stopLoopListener(String projectId) {\\r\\n        LoopExecutionThread thread = loopThreads.remove(projectId);\\r\\n        if (thread != null) {\\r\\n            thread.stop();\\r\\n            log.info(\\\"项目 {} 的循环执行监听器已停止\\\", projectId);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public void notifyLoopFlowsAvailable(String projectId) {\\r\\n        LoopExecutionThread thread = loopThreads.get(projectId);\\r\\n        if (thread != null) {\\r\\n            thread.notifyLoopFlowsAvailable();\\r\\n            log.debug(\\\"已通知项目循环执行线程: projectId={}\\\", projectId);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public boolean isLoopRunning(String projectId) {\\r\\n        LoopExecutionThread thread = loopThreads.get(projectId);\\r\\n        return thread != null && thread.isRunning();\\r\\n    }\\r\\n\\r\\n    public void stopAllLoopExecution() {\\r\\n        loopThreads.keySet().forEach(this::stopLoopListener);\\r\\n        log.info(\\\"已停止所有循环执行\\\");\\r\\n    }\\r\\n\\r\\n    // ==================== 流程控制 ====================\\r\\n\\r\\n    public boolean stopFlow(String projectId, String flowId) {\\r\\n        return executionEngine.stopFlow(projectId, flowId);\\r\\n    }\\r\\n}\",\"error\":\"\"}",
