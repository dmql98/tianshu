            "role": "tool",
            "content": "{\"output\":\"package com.industrial.scheduler;\\r\\n\\r\\nimport com.industrial.common.exception.ErrorException;\\r\\nimport com.industrial.config.FlowEngineConfig;\\r\\nimport com.industrial.constant.FlowConstants;\\r\\nimport com.industrial.context.FlowExecutionContext;\\r\\nimport com.industrial.engine.FlowExecutionEngine;\\r\\nimport com.industrial.model.FlowIndexInfo;\\r\\nimport com.industrial.service.FlowService;\\r\\nimport lombok.RequiredArgsConstructor;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\n\\r\\nimport java.util.Map;\\r\\nimport java.util.Set;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\nimport java.util.concurrent.Semaphore;\\r\\nimport java.util.concurrent.TimeUnit;\\r\\n\\r\\n/**\\r\\n * 循环流程执行线程\\r\\n * <p>\\r\\n * 负责单个项目的循环流程调度执行\\r\\n */\\r\\n@Slf4j\\r\\n@RequiredArgsConstructor\\r\\npublic class LoopExecutionThread {\\r\\n\\r\\n    private final String projectId;\\r\\n    private final FlowExecutionEngine executionEngine;\\r\\n    private final FlowService flowService;\\r\\n    private final FlowEngineConfig config;\\r\\n\\r\\n    private final Set<String> scheduledFlows = ConcurrentHashMap.newKeySet();\\r\\n    private final Map<String, Semaphore> flowSemaphores = new ConcurrentHashMap<>();\\r\\n    private final Semaphore executionSemaphore = new Semaphore(SchedulerConstants.MAX_CONCURRENT_LOOPS);\\r\\n\\r\\n    private volatile boolean running = false;\\r\\n    private volatile boolean shouldStop = false;\\r\\n    private volatile boolean hasLoopFlows = false;\\r\\n    private volatile long lastScheduleTime = 0;\\r\\n    private volatile Map<String, FlowIndexInfo> cachedLoopFlows = null;\\r\\n    private volatile long lastCacheTime = 0;\\r\\n    private Thread thread;\\r\\n    private final Object stopLock = new Object();\\r\\n    private volatile int activeFlowCount = 0;\\r\\n\\r\\n    public void start() {\\r\\n        if (running) {\\r\\n            log.warn(\\\"项目 {} 的循环执行线程已在运行\\\", projectId);\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        running = true;\\r\\n        shouldStop = false;\\r\\n        thread = new Thread(this::run, SchedulerConstants.LOOP_THREAD_PREFIX + \\\"-\\\" + projectId);\\r\\n        thread.setDaemon(true);\\r\\n        thread.start();\\r\\n        log.info(\\\"项目 {} 的循环执行线程已启动\\\", projectId);\\r\\n    }\\r\\n\\r\\n    public void stop() {\\r\\n        shouldStop = true;\\r\\n        running = false;\\r\\n        synchronized (stopLock) {\\r\\n            stopLock.notifyAll();\\r\\n        }\\r\\n        synchronized (this) {\\r\\n            notifyAll();\\r\\n        }\\r\\n        waitForActiveFlowsToComplete();\\r\\n        log.info(\\\"LoopExecutionThread 已停止: projectId={}\\\", projectId);\\r\\n    }\\r\\n\\r\\n    private void waitForActiveFlowsToComplete() {\\r\\n        long deadline = System.currentTimeMillis() + SchedulerConstants.STOP_WAIT_TIMEOUT_MS;\\r\\n        while (activeFlowCount > 0 && System.currentTimeMillis() < deadline) {\\r\\n            long remaining = deadline - System.currentTimeMillis();\\r\\n            long sleepTime = Math.min(remaining, SchedulerConstants.STOP_CHECK_INTERVAL_MS);\\r\\n            try {\\r\\n                Thread.sleep(sleepTime);\\r\\n            } catch (InterruptedException e) {\\r\\n                Thread.currentThread().interrupt();\\r\\n                break;\\r\\n            }\\r\\n            if (activeFlowCount == 0) {\\r\\n                break;\\r\\n            }\\r\\n        }\\r\\n        if (activeFlowCount > 0) {\\r\\n            log.warn(\\\"等待活跃流程完成超时，仍有 {} 个流程在执行: projectId={}\\\", activeFlowCount, projectId);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void incrementActiveFlowCount() {\\r\\n        synchronized (stopLock) {\\r\\n            activeFlowCount++;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void decrementActiveFlowCount() {\\r\\n        synchronized (stopLock) {\\r\\n            activeFlowCount--;\\r\\n            if (activeFlowCount < 0) {\\r\\n                activeFlowCount = 0;\\r\\n            }\\r\\n            if (shouldStop && activeFlowCount == 0) {\\r\\n                stopLock.notifyAll();\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public synchronized void notifyLoopFlowsAvailable() {\\r\\n        hasLoopFlows = true;\\r\\n        notifyAll();\\r\\n    }\\r\\n\\r\\n    public boolean isRunning() {\\r\\n        return running;\\r\\n    }\\r\\n\\r\\n    private Map<String, FlowIndexInfo> getLoopFlows() {\\r\\n        long now = System.currentTimeMillis();\\r\\n        if (cachedLoopFlows == null || (now - lastCacheTime) > SchedulerConstants.CACHE_INTERVAL_MS) {\\r\\n            cachedLoopFlows = flowService.getLoopFlowsFromDisk(projectId);\\r\\n            lastCacheTime = now;\\r\\n        }\\r\\n        return cachedLoopFlows;\\r\\n    }\\r\\n\\r\\n    private void invalidateCache() {\\r\\n        cachedLoopFlows = null;\\r\\n    }\\r\\n\\r\\n    private void run() {\\r\\n        log.info(\\\"循环执行线程启动: projectId={}\\\", projectId);\\r\\n\\r\\n        try {\\r\\n            while (!shouldStop) {\\r\\n                processLoopFlows();\\r\\n            }\\r\\n        } catch (InterruptedException e) {\\r\\n            Thread.currentThread().interrupt();\\r\\n            log.warn(\\\"循环执行线程被中断: projectId={}\\\", projectId);\\r\\n        } catch (ErrorException e) {\\r\\n            log.error(\\\"循环执行异常: projectId={}, error={}\\\", projectId, e.getMessage());\\r\\n        } finally {\\r\\n            scheduledFlows.clear();\\r\\n            running = false;\\r\\n            log.info(\\\"循环执行线程结束: projectId={}\\\", projectId);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void processLoopFlows() throws InterruptedException, ErrorException {\\r\\n        Map<String, FlowIndexInfo> loopFlows = getLoopFlows();\\r\\n\\r\\n        if (loopFlows.isEmpty()) {\\r\\n            log.debug(\\\"项目 {} 没有循环流程，进入等待状态\\\", projectId);\\r\\n            hasLoopFlows = false;\\r\\n            waitForLoopFlows();\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        for (Map.Entry<String, FlowIndexInfo> entry : loopFlows.entrySet()) {\\r\\n            String flowId = entry.getKey();\\r\\n            FlowIndexInfo info = entry.getValue();\\r\\n\\r\\n            if (!info.isLoop() || scheduledFlows.contains(flowId)) {\\r\\n                continue;\\r\\n            }\\r\\n\\r\\n            lastScheduleTime = System.currentTimeMillis();\\r\\n            scheduleLoopFlow(projectId, flowId, info, 0);\\r\\n        }\\r\\n\\r\\n        adaptiveSleep();\\r\\n    }\\r\\n\\r\\n    private void waitForLoopFlows() throws InterruptedException {\\r\\n        synchronized (this) {\\r\\n            while (!hasLoopFlows && !shouldStop) {\\r\\n                wait(SchedulerConstants.WAIT_FOR_LOOP_FLOWS_TIMEOUT_MS);\\r\\n\\r\\n                if (!hasLoopFlows) {\\r\\n                    invalidateCache();\\r\\n                    if (!getLoopFlows().isEmpty()) {\\r\\n                        hasLoopFlows = true;\\r\\n                        log.info(\\\"等待期间检测到循环流程: projectId={}\\\", projectId);\\r\\n                    }\\r\\n                }\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void adaptiveSleep() throws InterruptedException {\\r\\n        long elapsed = System.currentTimeMillis() - lastScheduleTime;\\r\\n\\r\\n        if (elapsed < SchedulerConstants.FAST_SCHEDULE_THRESHOLD_MS) {\\r\\n            Thread.sleep(SchedulerConstants.FAST_SLEEP_MS);\\r\\n        } else if (elapsed < SchedulerConstants.NORMAL_SCHEDULE_THRESHOLD_MS) {\\r\\n            Thread.sleep(SchedulerConstants.NORMAL_SLEEP_MS);\\r\\n        } else {\\r\\n            Thread.sleep(SchedulerConstants.SLOW_SLEEP_MS);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void scheduleLoopFlow(String projectId, String flowId, FlowIndexInfo info, long failureBackoffMs) {\\r\\n        if (shouldStop) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        Semaphore flowSemaphore = flowSemaphores.computeIfAbsent(flowId,\\r\\n                k -> new Semaphore(SchedulerConstants.MAX_CONCURRENT_PER_FLOW));\\r\\n\\r\\n        long flowIntervalMs = getFlowIntervalMs(info);\\r\\n        if (!acquireGlobalPermit(failureBackoffMs, flowIntervalMs)) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        if (!flowSemaphore.tryAcquire()) {\\r\\n            log.debug(\\\"该 flowId 的并发数已满: projectId={}, flowId={}\\\", projectId, flowId);\\r\\n            executionSemaphore.release();\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        if (shouldStop) {\\r\\n            releasePermits(flowId, flowSemaphore);\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        scheduledFlows.add(flowId);\\r\\n        incrementActiveFlowCount();\\r\\n\\r\\n        try {\\r\\n            Map<String, FlowIndexInfo> loopFlows = getLoopFlows();\\r\\n            FlowIndexInfo latestInfo = loopFlows.get(flowId);\\r\\n            if (latestInfo == null || !latestInfo.isLoop()) {\\r\\n                releasePermits(flowId, flowSemaphore);\\r\\n                decrementActiveFlowCount();\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            if (shouldStop) {\\r\\n                releasePermits(flowId, flowSemaphore);\\r\\n                decrementActiveFlowCount();\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            log.debug(\\\"执行循环流程: projectId={}, flowId={}, interval={}ms\\\", projectId, flowId, flowIntervalMs);\\r\\n\\r\\n            if (failureBackoffMs > 0) {\\r\\n                sleepQuietly(failureBackoffMs);\\r\\n                if (shouldStop) {\\r\\n                    releasePermits(flowId, flowSemaphore);\\r\\n                    decrementActiveFlowCount();\\r\\n                    return;\\r\\n                }\\r\\n            }\\r\\n\\r\\n            executeLoopFlowAsync(projectId, flowId, latestInfo, flowSemaphore);\\r\\n\\r\\n        } catch (Exception e) {\\r\\n            log.error(\\\"循环流程调度异常: projectId={}, flowId={}, error={}\\\", projectId, flowId, e.getMessage());\\r\\n            releasePermits(flowId, flowSemaphore);\\r\\n            decrementActiveFlowCount();\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private long getFlowIntervalMs(FlowIndexInfo info) {\\r\\n        if (info.getLoopInterval() == null || info.getLoopUnit() == null) {\\r\\n            return config.getLoopExecutionInterval();\\r\\n        }\\r\\n        int interval = info.getLoopInterval();\\r\\n        String unit = info.getLoopUnit().toLowerCase();\\r\\n        return switch (unit) {\\r\\n            case \\\"millisecond\\\" -> interval * 1L;\\r\\n            case \\\"second\\\" -> interval * 1000L;\\r\\n            case \\\"minute\\\" -> interval * 60 * 1000L;\\r\\n            case \\\"hour\\\" -> interval * 60 * 60 * 1000L;\\r\\n            default -> config.getLoopExecutionInterval();\\r\\n        };\\r\\n    }\\r\\n\\r\\n    private boolean acquireGlobalPermit(long failureBackoffMs, long flowIntervalMs) {\\r\\n        try {\\r\\n            long waitTime;\\r\\n            if (failureBackoffMs > 0) {\\r\\n                waitTime = failureBackoffMs;\\r\\n            } else if (flowIntervalMs > 0) {\\r\\n                waitTime = flowIntervalMs;\\r\\n            } else {\\r\\n                waitTime = 0;\\r\\n            }\\r\\n            return executionSemaphore.tryAcquire(waitTime, TimeUnit.MILLISECONDS);\\r\\n        } catch (InterruptedException e) {\\r\\n            Thread.currentThread().interrupt();\\r\\n            log.warn(\\\"等待全局信号量被中断: projectId={}\\\", projectId);\\r\\n            return false;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void releasePermits(String flowId, Semaphore flowSemaphore) {\\r\\n        scheduledFlows.remove(flowId);\\r\\n        flowSemaphore.release();\\r\\n        executionSemaphore.release();\\r\\n    }\\r\\n\\r\\n    private void executeLoopFlowAsync(String projectId, String flowId, FlowIndexInfo info, Semaphore flowSemaphore) {\\r\\n        final FlowExecutionContext[] contextHolder = new FlowExecutionContext[1];\\r\\n\\r\\n        contextHolder[0] = executionEngine.executeAsync(\\r\\n                projectId, flowId, FlowConstants.TRIGGER_TYPE_LOOP, null, null,\\r\\n                () -> {\\r\\n                    onFlowCompleted(projectId, flowId, info, contextHolder[0], flowSemaphore);\\r\\n                    decrementActiveFlowCount();\\r\\n                }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    private void onFlowCompleted(String projectId, String flowId, FlowIndexInfo info,\\r\\n                                  FlowExecutionContext execContext, Semaphore flowSemaphore) {\\r\\n        if (shouldStop) {\\r\\n            releasePermits(flowId, flowSemaphore);\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        Map<String, FlowIndexInfo> loopFlows = getLoopFlows();\\r\\n        FlowIndexInfo latestInfo = loopFlows.get(flowId);\\r\\n\\r\\n        if (latestInfo == null || !latestInfo.isLoop()) {\\r\\n            log.debug(\\\"流程不再是循环流程: projectId={}, flowId={}\\\", projectId, flowId);\\r\\n            releasePermits(flowId, flowSemaphore);\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        long flowIntervalMs = getFlowIntervalMs(latestInfo);\\r\\n        boolean isFailed = execContext != null && execContext.isFailed();\\r\\n\\r\\n        if (isFailed) {\\r\\n            log.warn(\\\"循环流程执行失败，准备退避重试: projectId={}, flowId={}\\\", projectId, flowId);\\r\\n            releasePermits(flowId, flowSemaphore);\\r\\n            long backoffMs = flowIntervalMs > 0 ? flowIntervalMs * SchedulerConstants.FAILURE_BACKOFF_MULTIPLIER : config.getLoopExecutionInterval();\\r\\n            scheduleLoopFlow(projectId, flowId, latestInfo, backoffMs);\\r\\n        } else {\\r\\n            log.debug(\\\"循环流程执行完成，等待间隔后重新调度: projectId={}, flowId={}, interval={}ms\\\", projectId, flowId, flowIntervalMs);\\r\\n            releasePermits(flowId, flowSemaphore);\\r\\n            scheduleLoopFlow(projectId, flowId, latestInfo, flowIntervalMs);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void sleepQuietly(long millis) {\\r\\n        try {\\r\\n            Thread.sleep(millis);\\r\\n        } catch (InterruptedException e) {\\r\\n            Thread.currentThread().interrupt();\\r\\n        }\\r\\n    }\\r\\n}\",\"error\":\"\"}",
