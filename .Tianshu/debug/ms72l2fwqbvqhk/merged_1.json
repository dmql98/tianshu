            "role": "tool",
            "content": "{\"output\":\"from collections.abc import Callable\\r\\nimport hashlib\\r\\nimport json\\r\\nfrom pathlib import Path\\r\\nfrom typing import Any, Literal\\r\\n\\r\\nimport numpy as np\\r\\nimport onnxruntime as ort\\r\\nimport yaml\\r\\nfrom PIL import Image\\r\\nfrom pydantic import BaseModel, ConfigDict, Field\\r\\n\\r\\nfrom app.domain.recognition import NormalizedBoundingBox\\r\\n\\r\\n\\r\\nDetectionLabel = Literal[\\r\\n    \\\"dimension_block\\\",\\r\\n    \\\"gdandt_frame\\\",\\r\\n    \\\"roughness\\\",\\r\\n    \\\"thread_callout\\\",\\r\\n    \\\"hole_callout\\\",\\r\\n    \\\"leader_arrow\\\",\\r\\n]\\r\\n\\r\\n\\r\\nclass Detection(BaseModel):\\r\\n    model_config = ConfigDict(extra=\\\"forbid\\\")\\r\\n\\r\\n    label: DetectionLabel\\r\\n    confidence: float = Field(ge=0, le=1)\\r\\n    bbox: NormalizedBoundingBox\\r\\n\\r\\n\\r\\nclass PaddleDetector:\\r\\n    \\\"\\\"\\\"Adapter boundary for a tenant-trained PaddleDetection model.\\\"\\\"\\\"\\r\\n\\r\\n    def __init__(\\r\\n        self,\\r\\n        model_dir: str | Path,\\r\\n        predictor_factory: Callable[[Path], Any] | None = None,\\r\\n        expected_model_sha256: str | None = None,\\r\\n        expected_labels_sha256: str | None = None,\\r\\n    ) -> None:\\r\\n        self.model_dir = Path(model_dir).resolve()\\r\\n        self._predictor_factory = predictor_factory\\r\\n        self._predictor: Any | None = None\\r\\n        model_path = self.model_dir / \\\"model.onnx\\\"\\r\\n        labels_path = self.model_dir / \\\"labels.json\\\"\\r\\n        if model_path.is_file() or labels_path.is_file():\\r\\n            if not expected_model_sha256 or not expected_labels_sha256:\\r\\n                raise ValueError(\\\"DETECTOR_CHECKSUMS_REQUIRED\\\")\\r\\n            if (\\r\\n                _sha256(model_path) != expected_model_sha256\\r\\n                or _sha256(labels_path) != expected_labels_sha256\\r\\n            ):\\r\\n                raise ValueError(\\\"DETECTOR_CHECKSUM_MISMATCH\\\")\\r\\n\\r\\n    @property\\r\\n    def available(self) -> bool:\\r\\n        return (\\r\\n            (self.model_dir / \\\"model.onnx\\\").is_file()\\r\\n            and (self.model_dir / \\\"labels.json\\\").is_file()\\r\\n            and (self.model_dir / \\\"infer_cfg.yml\\\").is_file()\\r\\n        )\\r\\n\\r\\n    def detect(self, image_path: str | Path) -> list[Detection]:\\r\\n        if not self.available:\\r\\n            return []\\r\\n        if self._predictor is None:\\r\\n            self._predictor = (\\r\\n                self._predictor_factory(self.model_dir)\\r\\n                if self._predictor_factory is not None\\r\\n                else PaddleDetectionOnnxPredictor(self.model_dir)\\r\\n            )\\r\\n        predictions = self._predictor.predict(str(Path(image_path).resolve()))\\r\\n        return [Detection.model_validate(item) for item in predictions]\\r\\n\\r\\n\\r\\nclass PaddleDetectionOnnxPredictor:\\r\\n    \\\"\\\"\\\"Run a PaddleDetection RT-DETR model exported to ONNX.\\\"\\\"\\\"\\r\\n\\r\\n    def __init__(self, model_dir: Path) -> None:\\r\\n        self.model_dir = model_dir\\r\\n        labels_payload = json.loads(\\r\\n            (model_dir / \\\"labels.json\\\").read_text(encoding=\\\"utf-8\\\")\\r\\n        )\\r\\n        self.labels = [\\r\\n            str(label)\\r\\n            for label in labels_payload[\\\"labels\\\"]\\r\\n        ]\\r\\n        unsupported = set(self.labels) - set(DetectionLabel.__args__)\\r\\n        if unsupported:\\r\\n            raise ValueError(\\r\\n                \\\"Unsupported detector labels: \\\"\\r\\n                + \\\", \\\".join(sorted(unsupported))\\r\\n            )\\r\\n        config = yaml.safe_load(\\r\\n            (model_dir / \\\"infer_cfg.yml\\\").read_text(encoding=\\\"utf-8\\\")\\r\\n        )\\r\\n        configured_labels = config.get(\\\"label_list\\\")\\r\\n        if configured_labels and list(configured_labels) != self.labels:\\r\\n            raise ValueError(\\\"Detector label files do not match\\\")\\r\\n        preprocess = config.get(\\\"Preprocess\\\", [])\\r\\n        resize = next(\\r\\n            (\\r\\n                step\\r\\n                for step in preprocess\\r\\n                if step.get(\\\"type\\\") == \\\"Resize\\\"\\r\\n            ),\\r\\n            None,\\r\\n        )\\r\\n        normalize = next(\\r\\n            (\\r\\n                step\\r\\n                for step in preprocess\\r\\n                if step.get(\\\"type\\\") == \\\"NormalizeImage\\\"\\r\\n            ),\\r\\n            None,\\r\\n        )\\r\\n        if resize is None or normalize is None:\\r\\n            raise ValueError(\\\"Unsupported PaddleDetection infer_cfg.yml\\\")\\r\\n        if bool(resize.get(\\\"keep_ratio\\\", False)):\\r\\n            raise ValueError(\\\"Detector Resize.keep_ratio must be false\\\")\\r\\n        target = resize[\\\"target_size\\\"]\\r\\n        if isinstance(target, int):\\r\\n            self.target_height = self.target_width = int(target)\\r\\n        else:\\r\\n            self.target_height = int(target[0])\\r\\n            self.target_width = int(target[1])\\r\\n        self.mean = np.asarray(\\r\\n            normalize.get(\\\"mean\\\", [0.0, 0.0, 0.0]),\\r\\n            dtype=np.float32,\\r\\n        )\\r\\n        self.std = np.asarray(\\r\\n            normalize.get(\\\"std\\\", [1.0, 1.0, 1.0]),\\r\\n            dtype=np.float32,\\r\\n        )\\r\\n        self.is_scale = bool(normalize.get(\\\"is_scale\\\", True))\\r\\n        self.score_threshold = float(config.get(\\\"draw_threshold\\\", 0.25))\\r\\n        self.session = ort.InferenceSession(\\r\\n            str(model_dir / \\\"model.onnx\\\"),\\r\\n            providers=[\\\"CPUExecutionProvider\\\"],\\r\\n        )\\r\\n\\r\\n    def predict(self, image_path: str) -> list[dict[str, Any]]:\\r\\n        with Image.open(image_path) as image:\\r\\n            rgb = image.convert(\\\"RGB\\\")\\r\\n            original_width, original_height = rgb.size\\r\\n            resized = rgb.resize(\\r\\n                (self.target_width, self.target_height)\\r\\n            )\\r\\n            array = np.asarray(resized, dtype=np.float32)\\r\\n        if self.is_scale:\\r\\n            array /= 255.0\\r\\n        array = (array - self.mean) / self.std\\r\\n        image_tensor = np.transpose(array, (2, 0, 1))[None, ...]\\r\\n        inputs: dict[str, np.ndarray] = {}\\r\\n        for model_input in self.session.get_inputs():\\r\\n            name = model_input.name\\r\\n            if name in {\\\"image\\\", \\\"images\\\", \\\"x\\\"}:\\r\\n                inputs[name] = image_tensor\\r\\n            elif name == \\\"im_shape\\\":\\r\\n                inputs[name] = np.asarray(\\r\\n                    [[\\r\\n                        float(self.target_height),\\r\\n                        float(self.target_width),\\r\\n                    ]],\\r\\n                    dtype=np.float32,\\r\\n                )\\r\\n            elif name == \\\"scale_factor\\\":\\r\\n                inputs[name] = np.asarray(\\r\\n                    [\\r\\n                        [\\r\\n                            self.target_height / original_height,\\r\\n                            self.target_width / original_width,\\r\\n                        ]\\r\\n                    ],\\r\\n                    dtype=np.float32,\\r\\n                )\\r\\n            else:\\r\\n                raise RuntimeError(\\r\\n                    f\\\"Unsupported detector input: {name}\\\"\\r\\n                )\\r\\n\\r\\n        raw = np.asarray(self.session.run(None, inputs)[0]).reshape(-1, 6)\\r\\n        predictions: list[dict[str, Any]] = []\\r\\n        for class_id, score, left, top, right, bottom in raw:\\r\\n            if float(score) < self.score_threshold:\\r\\n                continue\\r\\n            label_index = int(class_id)\\r\\n            if not 0 <= label_index < len(self.labels):\\r\\n                continue\\r\\n            normalized_left = max(\\r\\n                0.0,\\r\\n                min(1.0, float(left) / original_width),\\r\\n            )\\r\\n            normalized_top = max(\\r\\n                0.0,\\r\\n                min(1.0, float(top) / original_height),\\r\\n            )\\r\\n            normalized_right = max(\\r\\n                normalized_left,\\r\\n                min(1.0, float(right) / original_width),\\r\\n            )\\r\\n            normalized_bottom = max(\\r\\n                normalized_top,\\r\\n                min(1.0, float(bottom) / original_height),\\r\\n            )\\r\\n            if (\\r\\n                normalized_right <= normalized_left\\r\\n                or normalized_bottom <= normalized_top\\r\\n            ):\\r\\n                continue\\r\\n            predictions.append(\\r\\n                {\\r\\n                    \\\"label\\\": self.labels[label_index],\\r\\n                    \\\"confidence\\\": float(score),\\r\\n                    \\\"bbox\\\": {\\r\\n                        \\\"x\\\": normalized_left,\\r\\n                        \\\"y\\\": normalized_top,\\r\\n                        \\\"width\\\": normalized_right - normalized_left,\\r\\n                        \\\"height\\\": normalized_bottom - normalized_top,\\r\\n                    },\\r\\n                }\\r\\n            )\\r\\n        return predictions\\r\\n\\r\\n\\r\\ndef _sha256(path: Path) -> str:\\r\\n    if not path.is_file():\\r\\n        return \\\"\\\"\\r\\n    digest = hashlib.sha256()\\r\\n    with path.open(\\\"rb\\\") as stream:\\r\\n        for chunk in iter(lambda: stream.read(1024 * 1024), b\\\"\\\"):\\r\\n            digest.update(chunk)\\r\\n    return digest.hexdigest()\",\"error\":\"\"}",
