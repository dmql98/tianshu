            "content": "{\"output\":\"package com.industrial.engine;\\r\\n\\r\\nimport com.industrial.common.enums.ResultCode;\\r\\nimport com.industrial.common.exception.ErrorException;\\r\\nimport com.industrial.common.exception.FlowNodeSoftException;\\r\\nimport com.industrial.config.FlowEngineConfig;\\r\\nimport com.industrial.constant.FlowConstants;\\r\\nimport com.industrial.context.FlowExecutionContext;\\r\\nimport com.industrial.context.FlowExecutionRecorder;\\r\\nimport com.industrial.context.NodeExecutionTracker;\\r\\nimport com.industrial.model.FlowDefinition;\\r\\nimport com.industrial.model.FlowNode;\\r\\nimport com.industrial.model.VariableDefinition;\\r\\nimport com.industrial.node.FlowNodeExecutor;\\r\\nimport com.industrial.registry.FlowNodeRegistry;\\r\\nimport com.industrial.repository.ProjectRepository;\\r\\nimport com.industrial.service.FlowService;\\r\\nimport com.industrial.util.CommonUtils;\\r\\nimport com.industrial.util.ExecutorUtils;\\r\\nimport jakarta.annotation.PreDestroy;\\r\\nimport lombok.Builder;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\nimport org.springframework.context.annotation.Lazy;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport java.util.*;\\r\\nimport java.util.concurrent.CompletableFuture;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\nimport java.util.concurrent.ExecutorService;\\r\\nimport java.util.stream.Collectors;\\r\\nimport java.util.stream.IntStream;\\r\\n\\r\\n@Slf4j\\r\\n@Component\\r\\npublic class FlowExecutionEngine {\\r\\n\\r\\n    private final FlowNodeRegistry nodeRegistry;\\r\\n    private final FlowService flowService;\\r\\n    private final SubscriptionPusher subscriptionPusher;\\r\\n    private final ProjectRepository projectRepository;\\r\\n    private final FlowEngineConfig config;\\r\\n    private final ExecutorService executorService;\\r\\n\\r\\n    private final Map<String, FlowExecutionContext> runningFlows = new ConcurrentHashMap<>();\\r\\n    private final Map<String, String> executionToFlowKey = new ConcurrentHashMap<>();\\r\\n\\r\\n    public FlowExecutionEngine(FlowNodeRegistry nodeRegistry,\\r\\n                               @Lazy FlowService flowService,\\r\\n                               SubscriptionPusher subscriptionPusher,\\r\\n                               ProjectRepository projectRepository,\\r\\n                               FlowEngineConfig config) {\\r\\n        this.nodeRegistry = nodeRegistry;\\r\\n        this.flowService = flowService;\\r\\n        this.subscriptionPusher = subscriptionPusher;\\r\\n        this.projectRepository = projectRepository;\\r\\n        this.config = config;\\r\\n\\r\\n        this.executorService = ExecutorUtils.createDaemonThreadPool(\\r\\n                config.getExecutorCorePoolSize(),\\r\\n                config.getExecutorMaxPoolSize(),\\r\\n                config.getExecutorKeepAliveSeconds(),\\r\\n                config.getExecutorQueueCapacity(),\\r\\n                \\\"flow-executor\\\"\\r\\n        );\\r\\n    }\\r\\n\\r\\n    @PreDestroy\\r\\n    public void shutdown() {\\r\\n        log.info(\\\"关闭流程执行引擎...\\\");\\r\\n        runningFlows.values().forEach(FlowExecutionContext::markCancelled);\\r\\n        runningFlows.clear();\\r\\n        ExecutorUtils.shutdownGracefully(executorService, \\\"FlowExecutionEngine\\\");\\r\\n        log.info(\\\"流程执行引擎已关闭\\\");\\r\\n    }\\r\\n\\r\\n    // ==================== 公共API ====================\\r\\n\\r\\n    public FlowExecutionContext executeAsync(String projectId, String flowId,\\r\\n                                            String triggerType, Map<String, Object> inputs,\\r\\n                                            List<String> callChain,\\r\\n                                            Runnable completionCallback) {\\r\\n        FlowExecutionRequest request = FlowExecutionRequest.builder()\\r\\n                .projectId(projectId)\\r\\n                .flowId(flowId)\\r\\n                .triggerType(triggerType)\\r\\n                .inputs(inputs)\\r\\n                .parentCallChain(callChain)\\r\\n                .completionCallback(completionCallback)\\r\\n                .build();\\r\\n\\r\\n        FlowDefinition definition = fetchFlowDefinition(projectId, flowId);\\r\\n        List<String> effectiveCallChain = buildCallChain(callChain, flowId);\\r\\n        FlowExecutionContext context = createContext(request, definition, effectiveCallChain);\\r\\n\\r\\n        CompletableFuture.runAsync(() -> executeWithErrorHandling(context), executorService)\\r\\n                .exceptionally(ex -> {\\r\\n                    handleExecutionError(context, ex);\\r\\n                    return null;\\r\\n                });\\r\\n\\r\\n        return context;\\r\\n    }\\r\\n\\r\\n    public FlowExecutionContext executeSync(String projectId, String flowId,\\r\\n                                           String triggerType, Map<String, Object> inputs,\\r\\n                                           List<String> callChain) {\\r\\n        FlowDefinition definition = fetchFlowDefinition(projectId, flowId);\\r\\n        FlowExecutionRequest request = FlowExecutionRequest.builder()\\r\\n                .projectId(projectId)\\r\\n                .flowId(flowId)\\r\\n                .triggerType(triggerType)\\r\\n                .inputs(inputs)\\r\\n                .parentCallChain(callChain)\\r\\n                .build();\\r\\n\\r\\n        FlowExecutionContext context = createContext(request, definition, callChain);\\r\\n        executeAndCleanup(context);\\r\\n        return context;\\r\\n    }\\r\\n\\r\\n    public FlowExecutionContext executeSyncWithParent(String projectId, String flowId,\\r\\n                                                     String triggerType, Map<String, Object> inputs,\\r\\n                                                     List<String> callChain,\\r\\n                                                     FlowExecutionContext parentContext) {\\r\\n        FlowDefinition definition = fetchFlowDefinition(projectId, flowId);\\r\\n        FlowExecutionRequest request = FlowExecutionRequest.builder()\\r\\n                .projectId(projectId)\\r\\n                .flowId(flowId)\\r\\n                .triggerType(triggerType)\\r\\n                .inputs(inputs)\\r\\n                .parentCallChain(callChain)\\r\\n                .build();\\r\\n\\r\\n        FlowExecutionContext context = createContext(request, definition, callChain);\\r\\n        if (parentContext != null) {\\r\\n            context.setParentContext(parentContext);\\r\\n            log.debug(\\\"[父子上下文关联] childFlowId={}, parentFlowId={}\\\",\\r\\n                    flowId, parentContext.getFlowId());\\r\\n        }\\r\\n\\r\\n        executeAndCleanup(context);\\r\\n        return context;\\r\\n    }\\r\\n\\r\\n    // ==================== 执行状态查询 ====================\\r\\n\\r\\n    public FlowExecutionContext getRunningFlow(String projectId, String flowId) {\\r\\n        String flowKey = buildFlowKey(projectId, flowId);\\r\\n        return runningFlows.values().stream()\\r\\n                .filter(ctx -> flowKey.equals(executionToFlowKey.get(ctx.getExecutionId())))\\r\\n                .findFirst()\\r\\n                .orElse(null);\\r\\n    }\\r\\n\\r\\n    public List<FlowExecutionContext> getProjectRunningFlows(String projectId) {\\r\\n        String projectPrefix = projectId + \\\"_\\\";\\r\\n        Set<String> projectExecutionIds = executionToFlowKey.entrySet().stream()\\r\\n                .filter(entry -> entry.getValue().startsWith(projectPrefix))\\r\\n                .map(Map.Entry::getKey)\\r\\n                .collect(Collectors.toSet());\\r\\n\\r\\n        return runningFlows.entrySet().stream()\\r\\n                .filter(entry -> projectExecutionIds.contains(entry.getKey()))\\r\\n                .map(Map.Entry::getValue)\\r\\n                .collect(Collectors.toUnmodifiableList());\\r\\n    }\\r\\n\\r\\n    public Collection<FlowExecutionContext> getAllRunningFlows() {\\r\\n        return List.copyOf(runningFlows.values());\\r\\n    }\\r\\n\\r\\n    // ==================== 停止执行 ====================\\r\\n\\r\\n    public boolean stopFlow(String projectId, String flowId) {\\r\\n        String flowKey = buildFlowKey(projectId, flowId);\\r\\n        String executionId = findExecutionIdByFlowKey(flowKey);\\r\\n        if (executionId != null) {\\r\\n            return stopFlowByExecutionId(executionId);\\r\\n        }\\r\\n        return false;\\r\\n    }\\r\\n\\r\\n    public boolean stopFlowByExecutionId(String executionId) {\\r\\n        FlowExecutionContext context = runningFlows.remove(executionId);\\r\\n        if (context != null) {\\r\\n            context.markCancelled();\\r\\n            executionToFlowKey.remove(executionId);\\r\\n            return true;\\r\\n        }\\r\\n        return false;\\r\\n    }\\r\\n\\r\\n    // ==================== 私有方法 ====================\\r\\n\\r\\n    private FlowDefinition fetchFlowDefinition(String projectId, String flowId) {\\r\\n        try {\\r\\n            return flowService.getFlow(projectId, flowId);\\r\\n        } catch (ErrorException e) {\\r\\n            throw new RuntimeException(\\\"获取流程定义失败: \\\" + e.getMessage(), e);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private FlowExecutionContext createContext(FlowExecutionRequest request,\\r\\n                                               FlowDefinition definition,\\r\\n                                               List<String> callChain) {\\r\\n        FlowExecutionContext context = FlowExecutionContext.builder()\\r\\n                .config(config)\\r\\n                .projectId(request.projectId())\\r\\n                .flowId(request.flowId())\\r\\n                .flowDefinition(definition)\\r\\n                .triggerType(request.triggerType())\\r\\n                .inputs(request.inputs())\\r\\n                .parentCallChain(callChain)\\r\\n                .build();\\r\\n\\r\\n        if (request.completionCallback() != null) {\\r\\n            context.setCompletionCallback(request.completionCallback());\\r\\n        }\\r\\n\\r\\n        registerExecution(context);\\r\\n        return context;\\r\\n    }\\r\\n\\r\\n    private void registerExecution(FlowExecutionContext context) {\\r\\n        String executionId = context.getExecutionId();\\r\\n        String flowKey = buildFlowKey(context.getProjectId(), context.getFlowId());\\r\\n        runningFlows.put(executionId, context);\\r\\n        executionToFlowKey.put(executionId, flowKey);\\r\\n    }\\r\\n\\r\\n    private void unregisterExecution(String executionId) {\\r\\n        runningFlows.remove(executionId);\\r\\n        executionToFlowKey.remove(executionId);\\r\\n    }\\r\\n\\r\\n    private void executeWithErrorHandling(FlowExecutionContext context) {\\r\\n        try {\\r\\n            executeInternal(context);\\r\\n        } catch (Exception e) {\\r\\n            handleExecutionError(context, e);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void executeAndCleanup(FlowExecutionContext context) {\\r\\n        try {\\r\\n            executeInternal(context);\\r\\n        } catch (Exception e) {\\r\\n            handleExecutionError(context, e);\\r\\n        } finally {\\r\\n            unregisterExecution(context.getExecutionId());\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private List<String> buildCallChain(List<String> parentCallChain, String currentFlowId) {\\r\\n        if (parentCallChain == null || parentCallChain.isEmpty()) {\\r\\n            return List.of(currentFlowId);\\r\\n        }\\r\\n        List<String> newChain = new ArrayList<>(parentCallChain.size() + 1);\\r\\n        newChain.addAll(parentCallChain);\\r\\n        newChain.add(currentFlowId);\\r\\n        return newChain;\\r\\n    }\\r\\n\\r\\n    private void handleExecutionError(FlowExecutionContext context, Throwable ex) {\\r\\n        log.error(\\\"流程执行异常: executionId={}, error={}\\\", context.getExecutionId(), ex.getMessage());\\r\\n        context.markFailed(ex.getMessage());\\r\\n        unregisterExecution(context.getExecutionId());\\r\\n    }\\r\\n\\r\\n    private void executeInternal(FlowExecutionContext context) throws ErrorException {\\r\\n        List<FlowNode> nodes = context.getFlowDefinition().getNodes();\\r\\n\\r\\n        if (nodes == null || nodes.isEmpty()) {\\r\\n            throw new ErrorException(ResultCode.FLOW_NO_NODES, \\\"流程没有节点\\\");\\r\\n        }\\r\\n\\r\\n        FlowGraph graph = new FlowGraph(nodes);\\r\\n        FlowExecutionState state = new FlowExecutionState();\\r\\n        NodeExecutionTracker tracker = context.getNodeTracker();\\r\\n        FlowExecutionRecorder recorder = createRecorder(context);\\r\\n\\r\\n        recorder.recordFlowStart();\\r\\n        state.initStartNodes(graph.getStartNodes());\\r\\n\\r\\n        log.info(\\\"流程开始执行: flowId={}, 起始节点数={}, 总节点数={}\\\",\\r\\n                context.getFlowId(), state.getReadyQueue().size(), nodes.size());\\r\\n\\r\\n        try {\\r\\n            executeNodes(context, graph, state, tracker, recorder);\\r\\n        } catch (Exception e) {\\r\\n            FlowNode failedNode = graph.getNode(context.getCurrentNodeSeq());\\r\\n            handleNodeError(context, graph, state, e, tracker, recorder, failedNode);\\r\\n        } finally {\\r\\n            finishExecution(context, state, tracker, recorder);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private FlowExecutionRecorder createRecorder(FlowExecutionContext context) {\\r\\n        FlowDefinition definition = context.getFlowDefinition();\\r\\n        String flowName = Optional.ofNullable(definition.getName()).orElse(context.getFlowId());\\r\\n        String projectName = projectRepository.findById(context.getProjectId())\\r\\n                .map(p -> Optional.ofNullable(p.getName()).orElse(context.getProjectId()))\\r\\n                .orElse(context.getProjectId());\\r\\n\\r\\n        return new FlowExecutionRecorder(context, config.getExecutionRecordPath(), flowName, projectName);\\r\\n    }\\r\\n\\r\\n    private void executeNodes(FlowExecutionContext context, FlowGraph graph,\\r\\n                               FlowExecutionState state, NodeExecutionTracker tracker,\\r\\n                               FlowExecutionRecorder recorder) {\\r\\n        while (state.canContinue() && context.isRunning()) {\\r\\n            Integer nodeSeq = state.getReadyQueue().poll();\\r\\n            if (nodeSeq == null) break;\\r\\n\\r\\n            FlowNode node = graph.getNode(nodeSeq);\\r\\n            if (node == null) continue;\\r\\n            if (state.isFailedNode(nodeSeq)) {\\r\\n                log.debug(\\\"跳过失败节点: seq={}, nodeId={}\\\", nodeSeq, node.getNodeId());\\r\\n                continue;\\r\\n            }\\r\\n\\r\\n            executeNode(context, graph, state, tracker, recorder, nodeSeq, node);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void executeNode(FlowExecutionContext context, FlowGraph graph,\\r\\n                              FlowExecutionState state, NodeExecutionTracker tracker,\\r\\n                              FlowExecutionRecorder recorder, Integer nodeSeq, FlowNode node) {\\r\\n        log.debug(\\\"节点开始执行: seq={}, nodeId={}\\\", nodeSeq, node.getNodeId());\\r\\n\\r\\n        tracker.markNodeStart(nodeSeq);\\r\\n        context.setCurrentNode(nodeSeq);\\r\\n\\r\\n        try {\\r\\n            FlowNodeExecutor executor = nodeRegistry.getNode(node.getNodeId());\\r\\n            if (executor == null) {\\r\\n                throw new ErrorException(ResultCode.FLOW_NODE_NOT_REGISTERED,\\r\\n                        \\\"节点类型未注册: \\\" + node.getNodeId());\\r\\n            }\\r\\n\\r\\n            executor.execute(context);\\r\\n            completeNode(context, graph, state, tracker, recorder, nodeSeq, node);\\r\\n\\r\\n        } catch (FlowNodeSoftException e) {\\r\\n            // 软异常：忽略错误，继续流程执行\\r\\n            log.warn(\\\"节点执行忽略错误: seq={}, nodeId={}, error={}\\\", nodeSeq, node.getNodeId(), e.getMessage());\\r\\n            handleSoftError(context, graph, state, tracker, recorder, node, e);\\r\\n        } catch (Exception e) {\\r\\n            // 硬异常：仅标记当前节点失败，继续其它分支执行\\r\\n            log.error(\\\"节点执行失败: seq={}, nodeId={}, error={}\\\", nodeSeq, node.getNodeId(), e.getMessage());\\r\\n            handleNodeError(context, graph, state, e, tracker, recorder, node);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 节点完成的公共处理逻辑（记录、推送、激活下游）\\r\\n     */\\r\\n    private void handleNodeCompleteCommon(FlowExecutionContext context, FlowGraph graph,\\r\\n                                         FlowExecutionState state, NodeExecutionTracker tracker,\\r\\n                                         FlowExecutionRecorder recorder,\\r\\n                                         FlowNode node, String outputPort, String errorMessage) {\\r\\n        int nodeSeq = node.getSeq();\\r\\n\\r\\n        Map<String, Object> nodeOutputs = node.getOutputs() != null\\r\\n                ? context.getVariableCache().getNodeVariables(context.getFlowId(), nodeSeq)\\r\\n                : null;\\r\\n\\r\\n        if (nodeOutputs != null && !nodeOutputs.isEmpty()) {\\r\\n            Map<String, Object> maskedOutputs = CommonUtils.maskBase64ForLog(nodeOutputs);\\r\\n            log.info(\\\"节点输出: seq={}, nodeId={}, outputs={}\\\", nodeSeq, node.getNodeId(), maskedOutputs);\\r\\n        }\\r\\n\\r\\n        // 获取 formattedDetail\\r\\n        String formattedDetail = tracker.getNodeInfo(nodeSeq).formattedDetail();\\r\\n\\r\\n        if (errorMessage != null) {\\r\\n            recorder.recordNodeCompleteWithError(node, nodeOutputs, outputPort, errorMessage, formattedDetail);\\r\\n        } else {\\r\\n            recorder.recordNodeComplete(node, nodeOutputs, outputPort, formattedDetail);\\r\\n        }\\r\\n\\r\\n        if (FlowConstants.NODE_TYPE_IF.equals(node.getNodeId())) {\\r\\n            Boolean result = (Boolean) context.getTag(\\\"lastConditionResult\\\");\\r\\n            state.recordConditionResult(nodeSeq, Boolean.TRUE.equals(result));\\r\\n        }\\r\\n\\r\\n        subscriptionPusher.pushIfNeeded(context, node);\\r\\n        activateDownstreamNodes(context, graph, state, nodeSeq, node);\\r\\n    }\\r\\n\\r\\n    private void completeNode(FlowExecutionContext context, FlowGraph graph,\\r\\n                               FlowExecutionState state, NodeExecutionTracker tracker,\\r\\n                               FlowExecutionRecorder recorder, Integer nodeSeq, FlowNode node) {\\r\\n        tracker.markNodeComplete(nodeSeq, null);\\r\\n        state.completeNode(nodeSeq);\\r\\n        handleNodeCompleteCommon(context, graph, state, tracker, recorder, node, context.getLastOutputPort(), null);\\r\\n    }\\r\\n\\r\\n    private void activateDownstreamNodes(FlowExecutionContext context, FlowGraph graph,\\r\\n                                         FlowExecutionState state, int nodeSeq, FlowNode node) {\\r\\n        List<Integer> downstream = graph.computeDownstream(node, state.getConditionResults());\\r\\n        log.debug(\\\"下游节点: seq={} -> {}\\\", nodeSeq, downstream);\\r\\n\\r\\n        for (Integer targetSeq : downstream) {\\r\\n            List<Integer> allUpstreams = graph.getUpstream(targetSeq);\\r\\n            int remaining = state.activateNode(targetSeq, allUpstreams);\\r\\n\\r\\n            if (remaining == 0) {\\r\\n                state.getReadyQueue().offer(targetSeq);\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void handleNodeError(FlowExecutionContext context, FlowGraph graph, FlowExecutionState state,\\r\\n                                 Exception e, NodeExecutionTracker tracker, FlowExecutionRecorder recorder, FlowNode node) {\\r\\n        int nodeSeq = context.getCurrentNodeSeq();\\r\\n        tracker.markNodeFailed(nodeSeq, e.getMessage());\\r\\n        recorder.recordNodeFailed(node, e.getMessage());\\r\\n        state.failNode(nodeSeq);\\r\\n\\r\\n        if (isFanOutBranchNode(graph, nodeSeq)) {\\r\\n            log.warn(\\\"并行分支节点失败，保持其它分支继续执行: seq={}, nodeId={}\\\", nodeSeq, node.getNodeId());\\r\\n        } else {\\r\\n            context.markFailed(e.getMessage());\\r\\n        }\\r\\n\\r\\n        // 将错误信息输出到节点的输出变量中，供下游节点使用\\r\\n        outputErrorToNodeVariables(context, node, e);\\r\\n\\r\\n        // 推送错误信息到前端订阅者\\r\\n        subscriptionPusher.pushIfNeeded(context, node);\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 将错误信息输出到节点的输出变量中\\r\\n     * 如果节点定义了输出变量，则将错误信息设置到第一个非isTimeOut的输出变量\\r\\n     * 这样下游节点可以通过变量引用获取到错误信息\\r\\n     * 注意：isTimeOut是特殊变量，用于表示超时状态，不应被覆盖\\r\\n     */\\r\\n    private void outputErrorToNodeVariables(FlowExecutionContext context, FlowNode node, Exception e) {\\r\\n        Map<String, VariableDefinition> outputs = node.getOutputs();\\r\\n        if (outputs == null || outputs.isEmpty()) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        String errorMessage = e.getMessage() != null ? e.getMessage() : e.getClass().getSimpleName();\\r\\n\\r\\n        // 查找第一个非 isTimeOut 的输出变量\\r\\n        String targetVarName = outputs.keySet().stream()\\r\\n                .filter(varName -> !\\\"isTimeOut\\\".equals(varName))\\r\\n                .findFirst()\\r\\n                .orElse(null);\\r\\n\\r\\n        // 如果只有 isTimeOut 变量，则不覆盖已设置的超时值\\r\\n        if (targetVarName == null) {\\r\\n            log.debug(\\\"节点只有 isTimeOut 变量，跳过错误信息输出: nodeSeq={}\\\", node.getSeq());\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        context.updateNodeOutput(node.getSeq(), targetVarName, errorMessage);\\r\\n\\r\\n        log.debug(\\\"节点执行失败，已将错误信息输出到变量: nodeSeq={}, varName={}, error={}\\\",\\r\\n                node.getSeq(), targetVarName, errorMessage);\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 处理软异常（ignoreError模式下的错误）\\r\\n     * 节点标记为忽略状态，流程继续执行\\r\\n     */\\r\\n    private void handleSoftError(FlowExecutionContext context, FlowGraph graph,\\r\\n                                 FlowExecutionState state, NodeExecutionTracker tracker,\\r\\n                                 FlowExecutionRecorder recorder, FlowNode node, FlowNodeSoftException e) {\\r\\n        int nodeSeq = node.getSeq();\\r\\n        String errorMessage = e.getMessage();\\r\\n\\r\\n        // 1. 标记节点为忽略状态\\r\\n        tracker.markNodeIgnored(nodeSeq, errorMessage);\\r\\n\\r\\n        // 2. 将节点标记为已完成状态\\r\\n        state.completeNode(nodeSeq);\\r\\n\\r\\n        // 3. 先将错误信息输出到节点的输出变量中，再记录和推送\\r\\n        outputErrorToNodeVariables(context, node, e);\\r\\n\\r\\n        // 4. 公共的完成处理逻辑（记录、推送、激活下游）\\r\\n        handleNodeCompleteCommon(context, graph, state, tracker, recorder, node, FlowConstants.CONNECTION_NORMAL, errorMessage);\\r\\n\\r\\n        log.warn(\\\"节点忽略错误完成: seq={}, nodeId={}, message={}\\\", nodeSeq, node.getNodeId(), errorMessage);\\r\\n    }\\r\\n\\r\\n    private boolean isFanOutBranchNode(FlowGraph graph, int nodeSeq) {\\r\\n        List<Integer> upstreams = graph.getUpstream(nodeSeq);\\r\\n        if (upstreams.isEmpty()) {\\r\\n            return false;\\r\\n        }\\r\\n\\r\\n        for (Integer upstreamSeq : upstreams) {\\r\\n            if (upstreamSeq != null && graph.getDownstream(upstreamSeq).size() > 1) {\\r\\n                return true;\\r\\n            }\\r\\n        }\\r\\n        return false;\\r\\n    }\\r\\n\\r\\n    private void finishExecution(FlowExecutionContext context,\\r\\n                                  FlowExecutionState state, NodeExecutionTracker tracker,\\r\\n                                  FlowExecutionRecorder recorder) {\\r\\n        List<Integer> completedNodes = new ArrayList<>(state.getCompletedNodes());\\r\\n\\r\\n        if (tracker.hasFailedNodes() && context.isRunning()) {\\r\\n            context.markFailed(\\\"流程执行失败\\\");\\r\\n            recorder.recordFlowEnd(FlowConstants.STATUS_FAILED, completedNodes, \\\"存在执行失败的节点\\\");\\r\\n        } else if (tracker.hasFailedNodes()) {\\r\\n            recorder.recordFlowEnd(FlowConstants.STATUS_FAILED, completedNodes, \\\"存在执行失败的节点\\\");\\r\\n        } else {\\r\\n            context.markSuccess(completedNodes);\\r\\n            recorder.recordFlowEnd(FlowConstants.STATUS_SUCCESS, completedNodes, null);\\r\\n            logNodeExecutionOrder(context, tracker);\\r\\n        }\\r\\n\\r\\n        unregisterExecution(context.getExecutionId());\\r\\n\\r\\n        try {\\r\\n            recorder.saveToFile();\\r\\n        } catch (Exception e) {\\r\\n            log.error(\\\"保存执行记录失败: {}\\\", e.getMessage());\\r\\n        }\\r\\n\\r\\n        context.invokeCompletionCallback();\\r\\n    }\\r\\n\\r\\n    private String buildFlowKey(String projectId, String flowId) {\\r\\n        return projectId + \\\"_\\\" + flowId;\\r\\n    }\\r\\n\\r\\n    private String findExecutionIdByFlowKey(String flowKey) {\\r\\n        return executionToFlowKey.entrySet().stream()\\r\\n                .filter(entry -> flowKey.equals(entry.getValue()))\\r\\n                .map(Map.Entry::getKey)\\r\\n                .findFirst()\\r\\n                .orElse(null);\\r\\n    }\\r\\n\\r\\n    private void logNodeExecutionOrder(FlowExecutionContext context, NodeExecutionTracker tracker) {\\r\\n        List<NodeExecutionTracker.NodeExecutionInfo> completedNodes = tracker.getAllNodeInfo().stream()\\r\\n                .filter(info -> info.status() == NodeExecutionTracker.NodeStatus.COMPLETED)\\r\\n                .sorted(Comparator.comparingLong(NodeExecutionTracker.NodeExecutionInfo::startTime))\\r\\n                .toList();\\r\\n\\r\\n        if (completedNodes.isEmpty()) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        String orderLog = IntStream.range(0, completedNodes.size())\\r\\n                .mapToObj(i -> formatNodeInfo(completedNodes.get(i), i))\\r\\n                .collect(Collectors.joining(\\\" -> \\\", \\\"节点执行顺序: [\\\", \\\"]\\\"));\\r\\n\\r\\n        log.info(\\\"流程执行成功 - {}\\\", orderLog);\\r\\n    }\\r\\n\\r\\n    private String formatNodeInfo(NodeExecutionTracker.NodeExecutionInfo info, int index) {\\r\\n        String nodeName = Optional.ofNullable(info.nodeName()).orElse(info.nodeId());\\r\\n        return String.format(\\\"【%d】%s(%dms)\\\", info.seq(), nodeName, info.getDuration());\\r\\n    }\\r\\n\\r\\n    // ==================== 内部记录类 ====================\\r\\n\\r\\n    @Builder\\r\\n    private record FlowExecutionRequest(\\r\\n            String projectId,\\r\\n            String flowId,\\r\\n            String triggerType,\\r\\n            Map<String, Object> inputs,\\r\\n            List<String> parentCallChain,\\r\\n            Runnable completionCallback\\r\\n    ) {\\r\\n    }\\r\\n}\",\"error\":\"\"}",
