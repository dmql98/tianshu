            "content": "{\"output\":\"package com.industrial.engine;\\r\\n\\r\\nimport com.industrial.constant.FlowConstants;\\r\\nimport com.industrial.model.FlowNode;\\r\\nimport lombok.Getter;\\r\\n\\r\\nimport java.util.*;\\r\\nimport java.util.stream.Collectors;\\r\\n\\r\\npublic class FlowGraph {\\r\\n\\r\\n    private final Map<Integer, FlowNode> nodeMap;\\r\\n    private final Map<Integer, List<Integer>> upstreamMap;\\r\\n    private final Map<Integer, List<Integer>> downstreamMap;\\r\\n    @Getter\\r\\n    private final List<Integer> startNodes;\\r\\n\\r\\n    public FlowGraph(List<FlowNode> nodes) {\\r\\n        this.nodeMap = buildNodeMap(nodes);\\r\\n        this.upstreamMap = buildUpstreamMap(nodes);\\r\\n        this.downstreamMap = buildDownstreamMap(nodes);\\r\\n        this.startNodes = findStartNodes();\\r\\n    }\\r\\n\\r\\n    private Map<Integer, FlowNode> buildNodeMap(List<FlowNode> nodes) {\\r\\n        if (nodes == null || nodes.isEmpty()) {\\r\\n            return Collections.emptyMap();\\r\\n        }\\r\\n        Map<Integer, FlowNode> result = new HashMap<>();\\r\\n        for (FlowNode node : nodes) {\\r\\n            if (node != null && node.getSeq() != null) {\\r\\n                result.putIfAbsent(node.getSeq(), node);\\r\\n            }\\r\\n        }\\r\\n        return Collections.unmodifiableMap(result);\\r\\n    }\\r\\n\\r\\n    private Map<Integer, List<Integer>> buildUpstreamMap(List<FlowNode> nodes) {\\r\\n        if (nodes == null || nodes.isEmpty()) {\\r\\n            return Collections.emptyMap();\\r\\n        }\\r\\n        Map<Integer, List<Integer>> upstream = new HashMap<>();\\r\\n        nodes.forEach(n -> {\\r\\n            if (n != null && n.getSeq() != null) {\\r\\n                upstream.put(n.getSeq(), new ArrayList<>());\\r\\n            }\\r\\n        });\\r\\n\\r\\n        for (FlowNode node : nodes) {\\r\\n            if (node == null || node.getConnection() == null) {\\r\\n                continue;\\r\\n            }\\r\\n            for (Map.Entry<String, Object> entry : node.getConnection().entrySet()) {\\r\\n                List<Integer> targetSeqs = resolveTargets(entry.getValue());\\r\\n                for (Integer targetSeq : targetSeqs) {\\r\\n                    upstream.computeIfAbsent(targetSeq, k -> new ArrayList<>()).add(node.getSeq());\\r\\n                }\\r\\n            }\\r\\n        }\\r\\n        return upstream;\\r\\n    }\\r\\n\\r\\n    private Map<Integer, List<Integer>> buildDownstreamMap(List<FlowNode> nodes) {\\r\\n        if (nodes == null || nodes.isEmpty()) {\\r\\n            return Collections.emptyMap();\\r\\n        }\\r\\n        Map<Integer, List<Integer>> downstream = new HashMap<>();\\r\\n        nodes.forEach(n -> {\\r\\n            if (n != null && n.getSeq() != null) {\\r\\n                downstream.put(n.getSeq(), new ArrayList<>());\\r\\n            }\\r\\n        });\\r\\n\\r\\n        for (FlowNode node : nodes) {\\r\\n            if (node == null || node.getConnection() == null) {\\r\\n                continue;\\r\\n            }\\r\\n            for (Object targets : node.getConnection().values()) {\\r\\n                List<Integer> targetSeqs = resolveTargets(targets);\\r\\n                downstream.get(node.getSeq()).addAll(targetSeqs);\\r\\n            }\\r\\n        }\\r\\n        return downstream;\\r\\n    }\\r\\n\\r\\n    private List<Integer> findStartNodes() {\\r\\n        return nodeMap.values().stream()\\r\\n                .filter(node -> FlowConstants.NODE_TYPE_START.equals(node.getNodeId()))\\r\\n                .map(FlowNode::getSeq)\\r\\n                .sorted()\\r\\n                .collect(Collectors.toUnmodifiableList());\\r\\n    }\\r\\n\\r\\n    public List<Integer> computeDownstream(FlowNode currentNode, Map<Integer, Boolean> conditionResults) {\\r\\n        if (currentNode == null || !currentNode.hasConnection()) {\\r\\n            return Collections.emptyList();\\r\\n        }\\r\\n\\r\\n        Boolean condResult = conditionResults != null ? conditionResults.get(currentNode.getSeq()) : null;\\r\\n        return currentNode.getConnection().entrySet().stream()\\r\\n                .filter(entry -> shouldTakePort(entry.getKey(), condResult))\\r\\n                .flatMap(entry -> resolveTargets(entry.getValue()).stream())\\r\\n                .collect(Collectors.toUnmodifiableList());\\r\\n    }\\r\\n\\r\\n    private boolean shouldTakePort(String port, Boolean condResult) {\\r\\n        return switch (port) {\\r\\n            case FlowConstants.CONNECTION_NORMAL -> true;\\r\\n            case FlowConstants.CONNECTION_TRUE -> Boolean.TRUE.equals(condResult);\\r\\n            case FlowConstants.CONNECTION_FALSE -> Boolean.FALSE.equals(condResult);\\r\\n            default -> false;\\r\\n        };\\r\\n    }\\r\\n\\r\\n    private List<Integer> resolveTargets(Object targets) {\\r\\n        if (targets instanceof Integer single) {\\r\\n            return List.of(single);\\r\\n        }\\r\\n        if (targets instanceof List<?> list) {\\r\\n            @SuppressWarnings(\\\"unchecked\\\")\\r\\n            List<Integer> intList = (List<Integer>) list;\\r\\n            return List.copyOf(intList);\\r\\n        }\\r\\n        return List.of();\\r\\n    }\\r\\n\\r\\n    public List<Integer> getDownstream(int nodeSeq) {\\r\\n        return downstreamMap.getOrDefault(nodeSeq, List.of());\\r\\n    }\\r\\n\\r\\n    public List<Integer> getUpstream(int nodeSeq) {\\r\\n        return upstreamMap.getOrDefault(nodeSeq, List.of());\\r\\n    }\\r\\n\\r\\n    public FlowNode getNode(int seq) {\\r\\n        return nodeMap.get(seq);\\r\\n    }\\r\\n}\",\"error\":\"\"}",
