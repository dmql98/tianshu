            "role": "tool",
            "content": "{\"output\":\"package com.industrial.scheduler;\\r\\n\\r\\nimport com.industrial.config.FlowEngineConfig;\\r\\nimport com.industrial.model.FlowIndexInfo;\\r\\nimport com.industrial.service.FlowService;\\r\\nimport com.industrial.common.utils.JsonFileReader;\\r\\nimport jakarta.annotation.PreDestroy;\\r\\nimport lombok.RequiredArgsConstructor;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport java.io.File;\\r\\nimport java.util.Map;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\n\\r\\n/**\\r\\n * 循环流程监听器\\r\\n * <p>\\r\\n * 负责监控所有项目，当检测到有循环流程时自动启动对应的监听线程\\r\\n */\\r\\n@Slf4j\\r\\n@Component\\r\\n@RequiredArgsConstructor\\r\\npublic class LoopFlowListener {\\r\\n\\r\\n    private final FlowEngineConfig config;\\r\\n    private final FlowService flowService;\\r\\n    private final FlowScheduler flowScheduler;\\r\\n\\r\\n    private volatile boolean stopFlag = false;\\r\\n    private final Map<String, Boolean> watchedProjects = new ConcurrentHashMap<>();\\r\\n    private Thread listenerThread;\\r\\n\\r\\n    /**\\r\\n     * 初始化监听器\\r\\n     */\\r\\n    public void init() {\\r\\n        JsonFileReader.ensureDirectoryExists(config.getDataPath());\\r\\n        startListening();\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 启动监听\\r\\n     */\\r\\n    public void startListening() {\\r\\n        if (listenerThread != null && listenerThread.isAlive()) {\\r\\n            log.warn(\\\"监听器已在运行\\\");\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        stopFlag = false;\\r\\n        listenerThread = new Thread(this::run, SchedulerConstants.LISTENER_THREAD_NAME);\\r\\n        listenerThread.setDaemon(true);\\r\\n        listenerThread.start();\\r\\n\\r\\n        log.info(\\\"循环流程监听器已启动\\\");\\r\\n    }\\r\\n\\r\\n    @PreDestroy\\r\\n    public void stopListening() {\\r\\n        stopFlag = true;\\r\\n\\r\\n        if (listenerThread != null) {\\r\\n            listenerThread.interrupt();\\r\\n            listenerThread = null;\\r\\n        }\\r\\n\\r\\n        flowScheduler.stopAllLoopExecution();\\r\\n        log.info(\\\"循环流程监听器已停止\\\");\\r\\n    }\\r\\n\\r\\n    private void run() {\\r\\n        long checkInterval = config.getLoopCheckInterval();\\r\\n        log.info(\\\"循环流程监听器启动，检查间隔: {}ms\\\", checkInterval);\\r\\n\\r\\n        checkLoopFlows();\\r\\n\\r\\n        while (!stopFlag) {\\r\\n            try {\\r\\n                checkLoopFlows();\\r\\n                Thread.sleep(checkInterval);\\r\\n            } catch (InterruptedException e) {\\r\\n                Thread.currentThread().interrupt();\\r\\n                break;\\r\\n            } catch (Exception e) {\\r\\n                log.error(\\\"监听异常: {}\\\", e.getMessage(), e);\\r\\n                sleepQuietly(checkInterval);\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void checkLoopFlows() {\\r\\n        File dataDir = new File(config.getDataPath());\\r\\n        if (!dataDir.exists() || !dataDir.isDirectory()) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        File[] projectDirs = dataDir.listFiles(File::isDirectory);\\r\\n        if (projectDirs == null) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        for (File projectDir : projectDirs) {\\r\\n            String projectId = projectDir.getName();\\r\\n            if (isSystemProject(projectId)) {\\r\\n                continue;\\r\\n            }\\r\\n            checkProjectLoopFlows(projectId);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void checkProjectLoopFlows(String projectId) {\\r\\n        String flowIndexPath = config.getFlowIndexPath(projectId);\\r\\n        if (!new File(flowIndexPath).exists()) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        try {\\r\\n            Map<String, FlowIndexInfo> loopFlows = flowService.getLoopFlowsFromDisk(projectId);\\r\\n            if (loopFlows.isEmpty()) {\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            if (!watchedProjects.getOrDefault(projectId, false)) {\\r\\n                log.info(\\\"检测到项目有循环流程，启动监听: projectId={}\\\", projectId);\\r\\n                flowScheduler.startLoopListener(projectId);\\r\\n                watchedProjects.put(projectId, true);\\r\\n            }\\r\\n            flowScheduler.notifyLoopFlowsAvailable(projectId);\\r\\n\\r\\n        } catch (Exception e) {\\r\\n            log.error(\\\"检查项目循环流程失败: projectId={}, error={}\\\", projectId, e.getMessage());\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private boolean isSystemProject(String projectId) {\\r\\n        return \\\"project_index.json\\\".equals(projectId) || projectId.startsWith(\\\".\\\");\\r\\n    }\\r\\n\\r\\n    public void refresh() {\\r\\n        watchedProjects.clear();\\r\\n        log.info(\\\"循环流程监听已刷新\\\");\\r\\n    }\\r\\n\\r\\n    private void sleepQuietly(long millis) {\\r\\n        try {\\r\\n            Thread.sleep(millis);\\r\\n        } catch (InterruptedException e) {\\r\\n            Thread.currentThread().interrupt();\\r\\n        }\\r\\n    }\\r\\n}\",\"error\":\"\"}",
