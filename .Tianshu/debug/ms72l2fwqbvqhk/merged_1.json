            "content": "{\"output\":\"package com.industrial.util;\\r\\n\\r\\nimport com.industrial.config.FlowEngineConfig;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport jakarta.annotation.PostConstruct;\\r\\nimport java.util.Map;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\nimport java.util.concurrent.Semaphore;\\r\\nimport java.util.concurrent.atomic.AtomicInteger;\\r\\n\\r\\n/**\\r\\n * 子流程并发控制器\\r\\n * <p>\\r\\n * 用于控制子流程的并发数量，防止线程池爆炸\\r\\n * <p>\\r\\n * 控制维度：\\r\\n * 1. 全局并发数量 - 限制整个系统中同时执行的子流程总数\\r\\n * 2. 单流程并发数量 - 限制每个父流程同时调用的子流程数量\\r\\n */\\r\\n@Slf4j\\r\\n@Component\\r\\npublic class SubflowConcurrencyController {\\r\\n\\r\\n    private static final int DEFAULT_MAX_TOTAL = 20;\\r\\n    private static final int DEFAULT_MAX_PER_FLOW = 5;\\r\\n\\r\\n    private final FlowEngineConfig config;\\r\\n    private Semaphore globalSemaphore;\\r\\n    private final Map<String, Semaphore> flowSemaphores = new ConcurrentHashMap<>();\\r\\n    private final Map<String, AtomicInteger> flowActiveCount = new ConcurrentHashMap<>();\\r\\n\\r\\n    public SubflowConcurrencyController(FlowEngineConfig config) {\\r\\n        this.config = config;\\r\\n    }\\r\\n\\r\\n    @PostConstruct\\r\\n    public void init() {\\r\\n        this.globalSemaphore = new Semaphore(getMaxTotalConcurrent());\\r\\n        log.info(\\\"子流程并发控制器初始化完成: 全局最大并发={}\\\", getMaxTotalConcurrent());\\r\\n    }\\r\\n\\r\\n    private int getMaxTotalConcurrent() {\\r\\n        return config != null ? config.getMaxTotalConcurrentSubflows() : DEFAULT_MAX_TOTAL;\\r\\n    }\\r\\n\\r\\n    private int getMaxPerFlow() {\\r\\n        return config != null ? config.getMaxConcurrentSubflowsPerFlow() : DEFAULT_MAX_PER_FLOW;\\r\\n    }\\r\\n\\r\\n    public ConcurrencyPermit tryAcquire(String parentExecutionId) {\\r\\n        Semaphore flowSemaphore = flowSemaphores.computeIfAbsent(parentExecutionId,\\r\\n                k -> new Semaphore(getMaxPerFlow()));\\r\\n        AtomicInteger activeCount = flowActiveCount.computeIfAbsent(parentExecutionId,\\r\\n                k -> new AtomicInteger(0));\\r\\n\\r\\n        if (!globalSemaphore.tryAcquire()) {\\r\\n            log.warn(\\\"全局子流程并发数已达上限: executionId={}, max={}\\\", parentExecutionId, getMaxTotalConcurrent());\\r\\n            return ConcurrencyPermit.rejected(\\\"全局子流程并发数已达上限\\\");\\r\\n        }\\r\\n\\r\\n        if (!flowSemaphore.tryAcquire()) {\\r\\n            globalSemaphore.release();\\r\\n            log.warn(\\\"单个流程子流程并发数已达上限: executionId={}, max={}\\\", parentExecutionId, getMaxPerFlow());\\r\\n            return ConcurrencyPermit.rejected(\\\"单个流程子流程并发数已达上限\\\");\\r\\n        }\\r\\n\\r\\n        log.debug(\\\"子流程执行许可获取成功: executionId={}, 当前活跃数={}\\\",\\r\\n                parentExecutionId, activeCount.incrementAndGet());\\r\\n\\r\\n        return ConcurrencyPermit.acquired(parentExecutionId, flowSemaphore, activeCount);\\r\\n    }\\r\\n\\r\\n    public void release(String parentExecutionId, ConcurrencyPermit permit) {\\r\\n        if (permit == null) return;\\r\\n\\r\\n        if (permit.flowSemaphore() != null) {\\r\\n            permit.flowSemaphore().release();\\r\\n        }\\r\\n        globalSemaphore.release();\\r\\n\\r\\n        if (permit.activeCount() != null) {\\r\\n            int remaining = permit.activeCount().decrementAndGet();\\r\\n            log.debug(\\\"子流程执行许可释放: executionId={}, 剩余活跃数={}\\\", parentExecutionId, remaining);\\r\\n\\r\\n            if (remaining <= 0) {\\r\\n                flowSemaphores.remove(parentExecutionId);\\r\\n                flowActiveCount.remove(parentExecutionId);\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public record ConcurrencyPermit(\\r\\n            boolean acquired,\\r\\n            String parentExecutionId,\\r\\n            String reason,\\r\\n            Semaphore flowSemaphore,\\r\\n            AtomicInteger activeCount\\r\\n    ) {\\r\\n        public static ConcurrencyPermit acquired(String parentExecutionId, Semaphore flowSemaphore, AtomicInteger activeCount) {\\r\\n            return new ConcurrencyPermit(true, parentExecutionId, null, flowSemaphore, activeCount);\\r\\n        }\\r\\n\\r\\n        public static ConcurrencyPermit rejected(String reason) {\\r\\n            return new ConcurrencyPermit(false, null, reason, null, null);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 并发控制状态信息\\r\\n     */\\r\\n    public record ConcurrencyStatus(\\r\\n            int globalMaxConcurrent,\\r\\n            int globalAvailablePermits,\\r\\n            int activeFlowCount,\\r\\n            Map<String, FlowDetail> flowDetails\\r\\n    ) {\\r\\n        public record FlowDetail(\\r\\n                int maxPerFlow,\\r\\n                int activeCount,\\r\\n                int availablePermits\\r\\n        ) {}\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取当前并发控制状态\\r\\n     */\\r\\n    public ConcurrencyStatus getStatus() {\\r\\n        Map<String, ConcurrencyStatus.FlowDetail> flowDetails = new ConcurrentHashMap<>();\\r\\n        int maxPerFlow = getMaxPerFlow();\\r\\n\\r\\n        flowActiveCount.forEach((executionId, count) -> {\\r\\n            flowDetails.put(executionId, new ConcurrencyStatus.FlowDetail(\\r\\n                    maxPerFlow,\\r\\n                    count.get(),\\r\\n                    maxPerFlow - count.get()\\r\\n            ));\\r\\n        });\\r\\n\\r\\n        return new ConcurrencyStatus(\\r\\n                getMaxTotalConcurrent(),\\r\\n                globalSemaphore.availablePermits(),\\r\\n                flowActiveCount.size(),\\r\\n                flowDetails\\r\\n        );\\r\\n    }\\r\\n}\"}",
