            "content": "{\"output\":\"package com.industrial.node.retry;\\r\\n\\r\\nimport com.industrial.common.enums.ResultCode;\\r\\nimport com.industrial.common.exception.ErrorException;\\r\\nimport com.industrial.common.retry.ResilienceRetryService;\\r\\nimport lombok.RequiredArgsConstructor;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport java.util.function.Supplier;\\r\\n\\r\\n/**\\r\\n * 节点级重试辅助类\\r\\n * <p>\\r\\n * 职责：\\r\\n * - 从流程节点配置读取 retryCount 和 retryInterval (毫秒)\\r\\n * - 节点操作失败时重试\\r\\n * - 包装异常为 ErrorException\\r\\n */\\r\\n@Slf4j\\r\\n@Component\\r\\n@RequiredArgsConstructor\\r\\npublic class NodeRetryHelper {\\r\\n\\r\\n    public static final int DEFAULT_RETRY_COUNT = 0;\\r\\n    public static final int DEFAULT_RETRY_INTERVAL_MS = 1000;\\r\\n\\r\\n    private final ResilienceRetryService retryService;\\r\\n\\r\\n    /**\\r\\n     * 执行带重试的操作\\r\\n     */\\r\\n    public <T> T executeWithRetry(String operationName, int retryCount, long retryIntervalMs,\\r\\n                                  Supplier<T> operation) throws ErrorException {\\r\\n        if (retryCount <= 0) {\\r\\n            return executeOnce(operationName, operation);\\r\\n        }\\r\\n\\r\\n        int maxAttempts = retryCount + 1;\\r\\n\\r\\n        try {\\r\\n            return retryService.execute(operationName, maxAttempts, retryIntervalMs, () -> {\\r\\n                try {\\r\\n                    return operation.get();\\r\\n                } catch (Exception e) {\\r\\n                    throw wrapToRuntime(e);\\r\\n                }\\r\\n            });\\r\\n        } catch (Exception e) {\\r\\n            Throwable cause = e.getCause() != null ? e.getCause() : e;\\r\\n            throw wrapException(operationName, retryCount, retryIntervalMs, cause);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private <T> T executeOnce(String operationName, Supplier<T> operation) throws ErrorException {\\r\\n        try {\\r\\n            return operation.get();\\r\\n        } catch (Exception e) {\\r\\n            throw wrapException(operationName, 0, 0, e);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private RuntimeException wrapToRuntime(Exception e) {\\r\\n        return e instanceof RuntimeException ? (RuntimeException) e : new RuntimeException(e);\\r\\n    }\\r\\n\\r\\n    private ErrorException wrapException(String operationName, int retryCount, long intervalMs, Throwable cause) {\\r\\n        String errorMsg = formatErrorMessage(operationName, retryCount, intervalMs, cause);\\r\\n        log.error(errorMsg);\\r\\n\\r\\n        if (cause instanceof ErrorException) {\\r\\n            return (ErrorException) cause;\\r\\n        }\\r\\n        String fullMessage = cause != null ? errorMsg + \\\": \\\" + cause.getMessage() : errorMsg;\\r\\n        return new ErrorException(ResultCode.FLOW_NODE_EXECUTION_FAILED, fullMessage);\\r\\n    }\\r\\n\\r\\n    private String formatErrorMessage(String operationName, int retryCount, long intervalMs, Throwable cause) {\\r\\n        String causeMsg = cause != null && cause.getMessage() != null ? cause.getMessage() : \\\"未知错误\\\";\\r\\n\\r\\n        if (retryCount <= 0) {\\r\\n            return String.format(\\\"%s 执行失败: %s\\\", operationName, causeMsg);\\r\\n        }\\r\\n\\r\\n        return String.format(\\\"%s 执行失败，已重试 %d 次 (间隔 %dms): %s\\\",\\r\\n                operationName, retryCount, intervalMs, causeMsg);\\r\\n    }\\r\\n}\",\"error\":\"\"}",
