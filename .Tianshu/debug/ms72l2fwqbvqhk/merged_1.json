.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\jdk\\\\legal\\\\jdk.internal.le\\\\jline.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\jdk\\\\legal\\\\jdk.internal.opt\\\\jopt-simple.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\jdk\\\\legal\\\\jdk.javadoc\\\\jquery.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\jdk\\\\legal\\\\jdk.javadoc\\\\jqueryUI.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\jdk\\\\legal\\\\jdk.localedata\\\\cldr.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\jdk\\\\legal\\\\jdk.localedata\\\\thaidict.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\node\\\\CHANGELOG.md\\r\\nC:\\\\Users\\\\dmql\\\\Documents\\\\low-code-platform\\\\setup\\\\tools\\\\node\\\\README.md\",\"error\":\"\"}",
