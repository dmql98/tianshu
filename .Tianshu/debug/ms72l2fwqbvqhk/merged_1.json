nId = UUID.randomUUID().toString().replace(\\\"-\\\", \\\"\\\");\\r\\n        this.projectId = builder.projectId;\\r\\n        this.flowId = builder.flowId;\\r\\n        this.flowDefinition = builder.flowDefinition;\\r\\n        this.triggerType = builder.triggerType;\\r\\n        this.startTime = System.currentTimeMillis();\\r\\n        this.callChain = builder.parentCallChain != null && !builder.parentCallChain.isEmpty()\\r\\n                ? new ArrayList<>(builder.parentCallChain) : new ArrayList<>();\\r\\n        this.externalInput = new ExternalInputStore();\\r\\n        if (builder.inputs != null && !builder.inputs.isEmpty()) {\\r\\n            this.externalInput.putAll(builder.inputs);\\r\\n        }\\r\\n\\r\\n        this.variableCache = new FlowVariableCache();\\r\\n        this.nodeTracker = new NodeExecutionTracker();\\r\\n\\r\\n        if (flowDefinition != null && flowDefinition.getNodes() != null) {\\r\\n            this.nodeTracker.initialize(flowDefinition.getNodes());\\r\\n        }\\r\\n\\r\\n        if (!callChain.isEmpty()) {\\r\\n            log.info(\\\"创建流程执行上下文: executionId={}, projectId={}, flowId={}, triggerType={}, callChain={}\\\",\\r\\n                    executionId, projectId, flowId, triggerType, callChain);\\r\\n        } else {\\r\\n            log.info(\\\"创建流程执行上下文: executionId={}, projectId={}, flowId={}, triggerType={}\\\",\\r\\n                    executionId, projectId, flowId, triggerType);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public static Builder builder() {\\r\\n        return new Builder();\\r\\n    }\\r\\n\\r\\n    public static class Builder {\\r\\n        private FlowEngineConfig config;\\r\\n        private String projectId;\\r\\n        private String flowId;\\r\\n        private FlowDefinition flowDefinition;\\r\\n        private String triggerType;\\r\\n        private Map<String, Object> inputs;\\r\\n        private List<String> parentCallChain;\\r\\n\\r\\n        public Builder config(FlowEngineConfig config) { this.config = config; return this; }\\r\\n        public Builder projectId(String projectId) { this.projectId = projectId; return this; }\\r\\n        public Builder flowId(String flowId) { this.flowId = flowId; return this; }\\r\\n        public Builder flowDefinition(FlowDefinition flowDefinition) { this.flowDefinition = flowDefinition; return this; }\\r\\n        public Builder triggerType(String triggerType) { this.triggerType = triggerType; return this; }\\r\\n        public Builder inputs(Map<String, Object> inputs) { this.inputs = inputs; return this; }\\r\\n        public Builder parentCallChain(List<String> parentCallChain) { this.parentCallChain = parentCallChain; return this; }\\r\\n        public FlowExecutionContext build() { return new FlowExecutionContext(this); }\\r\\n    }\\r\\n\\r\\n    public boolean isInCallChain(String targetFlowId) {\\r\\n        return targetFlowId != null && callChain.contains(targetFlowId);\\r\\n    }\\r\\n\\r\\n    public void addToCallChain(String flowId) {\\r\\n        if (flowId != null && !callChain.contains(flowId)) {\\r\\n            callChain.add(flowId);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public boolean isCallChainTooDeep() {\\r\\n        return callChain.size() >= getMaxCallChainDepth();\\r\\n    }\\r\\n\\r\\n    public int getMaxCallChainDepth() {\\r\\n        return config != null ? config.getMaxCallChainDepth() : 10;\\r\\n    }\\r\\n\\r\\n    public String getCallChainDescription() {\\r\\n        return String.join(\\\" → \\\", callChain);\\r\\n    }\\r\\n\\r\\n    public void setCurrentNode(Integer nodeSeq) {\\r\\n        this.currentNodeSeq = nodeSeq;\\r\\n    }\\r\\n\\r\\n    public FlowNode findNodeBySeq(Integer nodeSeq) {\\r\\n        if (nodeSeq == null) {\\r\\n            return null;\\r\\n        }\\r\\n        return findNodeBySeq(this.flowId, nodeSeq);\\r\\n    }\\r\\n\\r\\n    public FlowNode getCurrentNode() {\\r\\n        return findNodeBySeq(currentNodeSeq);\\r\\n    }\\r\\n\\r\\n    public FlowNode findNodeBySeq(String flowId, int nodeSeq) {\\r\\n        if (flowDefinition == null || flowDefinition.getNodes() == null) {\\r\\n            return null;\\r\\n        }\\r\\n        return flowDefinition.getNodes().stream()\\r\\n                .filter(n -> n.getSeq() != null && n.getSeq() == nodeSeq)\\r\\n                .findFirst()\\r\\n                .orElse(null);\\r\\n    }\\r\\n\\r\\n    public void putNodeOutputs(Integer nodeSeq, Map<String, Object> outputs) {\\r\\n        if (outputs != null && !outputs.isEmpty()) {\\r\\n            variableCache.putAll(flowId, nodeSeq, outputs);\\r\\n            log.debug(\\\"存储节点输出: flowId={}, nodeSeq={}, outputs={}\\\", flowId, nodeSeq, outputs.keySet());\\r\\n        }\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 更新单个节点输出变量，不影响其他变量\\r\\n     */\\r\\n    public void updateNodeOutput(Integer nodeSeq, String varName, Object value) {\\r\\n        variableCache.put(flowId, nodeSeq, varName, value);\\r\\n        log.debug(\\\"更新节点输出变量: flowId={}, nodeSeq={}, varName={}, value={}\\\", flowId, nodeSeq, varName, value);\\r\\n    }\\r\\n\\r\\n    public Object getNodeOutput(Integer nodeSeq, String varName) {\\r\\n        return variableCache.get(flowId, nodeSeq, varName);\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取节点的所有输出变量\\r\\n     */\\r\\n    public Map<String, Object> getNodeOutputs(Integer nodeSeq) {\\r\\n        return variableCache.getNodeVariables(flowId, nodeSeq);\\r\\n    }\\r\\n\\r\\n    public Object getExternalInput(String varName) {\\r\\n        return externalInput.get(varName);\\r\\n    }\\r\\n\\r\\n    public Object resolveReference(String reference) {\\r\\n        if (reference == null || reference.isEmpty()) {\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n        String ref = extractRefContent(reference);\\r\\n        if (ref.startsWith(FlowConstants.GLOBAL_VARIABLE_PREFIX)) {\\r\\n            String variableId = ref.substring(FlowConstants.GLOBAL_VARIABLE_PREFIX.length());\\r\\n            return resolveGlobalVariable(variableId);\\r\\n        }\\r\\n        return resolveNodeVariable(ref);\\r\\n    }\\r\\n\\r\\n    private String extractRefContent(String reference) {\\r\\n        return (reference.startsWith(\\\"${\\\") && reference.endsWith(\\\"}\\\"))\\r\\n                ? reference.substring(2, reference.length() - 1) : reference;\\r\\n    }\\r\\n\\r\\n    private Object resolveNodeVariable(String ref) {\\r\\n        String[] parts = ref.split(SEP);\\r\\n        if (parts.length < 3) {\\r\\n            log.warn(\\\"无效的变量引用格式: {}\\\", ref);\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n\\r\\n        String refFlowId = parts[0];\\r\\n        int refNodeSeq = parseNodeSeq(parts[1], ref);\\r\\n        String varName = extractVarName(parts);\\r\\n\\r\\n        if (varName == null) {\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n\\r\\n        Object value = variableCache.get(refFlowId, refNodeSeq, varName);\\r\\n        if (TypeConvertUtil.hasValue(value)) {\\r\\n            return value;\\r\\n        }\\r\\n\\r\\n        value = getDefaultValue(refFlowId, refNodeSeq, varName);\\r\\n        if (TypeConvertUtil.hasValue(value)) {\\r\\n            return value;\\r\\n        }\\r\\n\\r\\n        return parentContext != null\\r\\n                ? parentContext.resolveNodeVariableFromAncestor(refFlowId, refNodeSeq, varName)\\r\\n                : \\\"\\\";\\r\\n    }\\r\\n\\r\\n    public Object resolveNodeVariableFromAncestor(String refFlowId, int refNodeSeq, String varName) {\\r\\n        Object value = variableCache.get(refFlowId, refNodeSeq, varName);\\r\\n        if (TypeConvertUtil.hasValue(value)) {\\r\\n            return value;\\r\\n        }\\r\\n\\r\\n        FlowNode node = findNodeBySeq(refFlowId, refNodeSeq);\\r\\n        VariableDefinition varDef = (node != null && node.getOutputs() != null) ? node.getOutputs().get(varName) : null;\\r\\n        if (varDef != null && varDef.isHasDefaultValue()) {\\r\\n            return varDef.getDefault();\\r\\n        }\\r\\n\\r\\n        return parentContext != null\\r\\n                ? parentContext.resolveNodeVariableFromAncestor(refFlowId, refNodeSeq, varName)\\r\\n                : \\\"\\\";\\r\\n    }\\r\\n\\r\\n    public void setParentContext(FlowExecutionContext parentContext) {\\r\\n        this.parentContext = parentContext;\\r\\n    }\\r\\n\\r\\n    public Object resolveNodeVariableFromAnyContext(String refFlowId, int refNodeSeq, String varName) {\\r\\n        if (refFlowId == null || varName == null) {\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n\\r\\n        if (refFlowId.equals(this.flowId)) {\\r\\n            return resolveNodeVariableFromAncestor(refFlowId, refNodeSeq, varName);\\r\\n        }\\r\\n\\r\\n        if (parentContext != null) {\\r\\n            return parentContext.resolveNodeVariableFromAnyContext(refFlowId, refNodeSeq, varName);\\r\\n        }\\r\\n\\r\\n        return \\\"\\\";\\r\\n    }\\r\\n\\r\\n    private int parseNodeSeq(String seqStr, String reference) {\\r\\n        try {\\r\\n            return Integer.parseInt(seqStr);\\r\\n        } catch (NumberFormatException e) {\\r\\n            log.warn(\\\"变量引用中的节点顺序号格式错误: {}\\\", reference);\\r\\n            return 0;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private String extractVarName(String[] parts) {\\r\\n        if (parts.length <= 2) {\\r\\n            return null;\\r\\n        }\\r\\n        if (parts.length == 3) {\\r\\n            return parts[2];\\r\\n        }\\r\\n        return String.join(\\\":\\\", java.util.Arrays.copyOfRange(parts, 2, parts.length));\\r\\n    }\\r\\n\\r\\n    private Object resolveGlobalVariable(String variableId) {\\r\\n        return VariableResolver.resolveGlobalVariable(projectId, variableId);\\r\\n    }\\r\\n\\r\\n    private Object getDefaultValue(String flowId, int nodeSeq, String varName) {\\r\\n        FlowNode node = findNodeBySeq(flowId, nodeSeq);\\r\\n        if (node == null || node.getOutputs() == null) {\\r\\n            return null;\\r\\n        }\\r\\n        VariableDefinition varDef = node.getOutputs().get(varName);\\r\\n        if (varDef != null && varDef.isHasDefaultValue()) {\\r\\n            return varDef.getDefault();\\r\\n        }\\r\\n        return null;\\r\\n    }\\r\\n\\r\\n    public Map<String, Object> resolveConfig(Map<String, Object> config) {\\r\\n        return ConfigResolver.resolveConfig(config, this);\\r\\n    }\\r\\n\\r\\n    public void setTag(String key, Object value) {\\r\\n        tags.put(key, value);\\r\\n    }\\r\\n\\r\\n    public Object getTag(String key) {\\r\\n        return tags.get(key);\\r\\n    }\\r\\n\\r\\n    public void markSuccess(Object result) {\\r\\n        this.status = FlowConstants.STATUS_SUCCESS;\\r\\n        this.result = result;\\r\\n        log.info(\\\"流程执行成功: executionId={}, flowId={}, duration={}ms\\\",\\r\\n                executionId, flowId, getDuration());\\r\\n    }\\r\\n\\r\\n    public void markFailed(String errorMessage) {\\r\\n        this.status = FlowConstants.STATUS_FAILED;\\r\\n        this.errorMessage = errorMessage;\\r\\n        log.error(\\\"流程执行失败: executionId={}, flowId={}, error={}\\\",\\r\\n                executionId, flowId, errorMessage);\\r\\n    }\\r\\n\\r\\n    public void markCancelled() {\\r\\n        this.status = FlowConstants.STATUS_CANCELLED;\\r\\n        log.warn(\\\"流程执行取消: executionId={}, flowId={}\\\", executionId, flowId);\\r\\n    }\\r\\n\\r\\n    public void setCompletionCallback(Runnable callback) {\\r\\n        this.completionCallback = callback;\\r\\n    }\\r\\n\\r\\n    public void invokeCompletionCallback() {\\r\\n        if (completionCallback != null) {\\r\\n            try {\\r\\n                completionCallback.run();\\r\\n            } catch (Exception e) {\\r\\n                log.error(\\\"执行完成回调异常: {}\\\", e.getMessage(), e);\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public long getDuration() {\\r\\n        return System.currentTimeMillis