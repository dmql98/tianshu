          {
            "role": "tool",
            "content": "{\"output\":\"package com.industrial.context;\\r\\n\\r\\nimport com.industrial.model.FlowNode;\\r\\nimport lombok.Getter;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\n\\r\\nimport java.util.*;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\nimport java.util.function.Predicate;\\r\\nimport java.util.stream.Collectors;\\r\\n\\r\\nimport static com.industrial.context.NodeExecutionTracker.NodeStatus.*;\\r\\n\\r\\n@Slf4j\\r\\n@Getter\\r\\npublic class NodeExecutionTracker {\\r\\n\\r\\n    public enum NodeStatus {\\r\\n        WAITING, RUNNING, COMPLETED, SKIPPED, IGNORED, FAILED\\r\\n    }\\r\\n\\r\\n    private static long currentTime() {\\r\\n        return System.currentTimeMillis();\\r\\n    }\\r\\n\\r\\n    public record NodeExecutionInfo(\\r\\n            int seq,\\r\\n            String nodeId,\\r\\n            String nodeName,\\r\\n            NodeStatus status,\\r\\n            long startTime,\\r\\n            long endTime,\\r\\n            Object result,\\r\\n            String errorMessage,\\r\\n            String formattedDetail\\r\\n    ) {\\r\\n        public long getDuration() {\\r\\n            return endTime > 0 ? endTime - startTime : currentTime() - startTime;\\r\\n        }\\r\\n\\r\\n        public NodeExecutionInfo withStatus(NodeStatus newStatus) {\\r\\n            return new NodeExecutionInfo(seq, nodeId, nodeName, newStatus, currentTime(), currentTime(), result, errorMessage, formattedDetail);\\r\\n        }\\r\\n\\r\\n        public NodeExecutionInfo withResult(Object newResult) {\\r\\n            return new NodeExecutionInfo(seq, nodeId, nodeName, status, startTime, currentTime(), newResult, errorMessage, formattedDetail);\\r\\n        }\\r\\n\\r\\n        public NodeExecutionInfo withError(String error) {\\r\\n            return new NodeExecutionInfo(seq, nodeId, nodeName, FAILED, startTime, currentTime(), result, error, formattedDetail);\\r\\n        }\\r\\n\\r\\n        public NodeExecutionInfo withFormattedDetail(String detail) {\\r\\n            return new NodeExecutionInfo(seq, nodeId, nodeName, status, startTime, endTime, result, errorMessage, detail);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private final Map<Integer, NodeExecutionInfo> executionInfoMap = new ConcurrentHashMap<>();\\r\\n\\r\\n    public void initialize(List<FlowNode> nodes) {\\r\\n        if (nodes == null || nodes.isEmpty()) {\\r\\n            return;\\r\\n        }\\r\\n        executionInfoMap.clear();\\r\\n\\r\\n        for (FlowNode node : nodes) {\\r\\n            if (node == null || node.getSeq() == null) {\\r\\n                continue;\\r\\n            }\\r\\n            executionInfoMap.put(node.getSeq(), new NodeExecutionInfo(\\r\\n                    node.getSeq(), node.getNodeId(), node.getName(),\\r\\n                    NodeStatus.WAITING, 0, 0, null, null, null));\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public void markNodeStart(Integer seq) {\\r\\n        updateNodeStatus(seq, RUNNING, null, null);\\r\\n    }\\r\\n\\r\\n    public void markNodeComplete(Integer seq, Object result) {\\r\\n        updateNodeStatus(seq, COMPLETED, result, null);\\r\\n    }\\r\\n\\r\\n    public void markNodeFailed(Integer seq, String errorMessage) {\\r\\n        updateNodeStatus(seq, FAILED, null, errorMessage);\\r\\n    }\\r\\n\\r\\n    public void markNodeIgnored(Integer seq, String errorMessage) {\\r\\n        updateNodeStatus(seq, IGNORED, null, errorMessage);\\r\\n    }\\r\\n\\r\\n    public void setNodeFormattedDetail(Integer seq, String formattedDetail) {\\r\\n        NodeExecutionInfo info = executionInfoMap.get(seq);\\r\\n        if (info != null) {\\r\\n            executionInfoMap.put(seq, info.withFormattedDetail(formattedDetail));\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private void updateNodeStatus(Integer seq, NodeStatus newStatus, Object result, String error) {\\r\\n        NodeExecutionInfo info = executionInfoMap.get(seq);\\r\\n        if (info == null) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        NodeExecutionInfo newInfo = switch (newStatus) {\\r\\n            case RUNNING -> info.withStatus(RUNNING);\\r\\n            case COMPLETED -> new NodeExecutionInfo(info.seq(), info.nodeId(), info.nodeName(), COMPLETED,\\r\\n                    info.startTime(), currentTime(), result, info.errorMessage(), info.formattedDetail());\\r\\n            case IGNORED -> new NodeExecutionInfo(info.seq(), info.nodeId(), info.nodeName(), IGNORED,\\r\\n                    info.startTime(), currentTime(), result, error, info.formattedDetail());\\r\\n            case FAILED -> info.withError(error);\\r\\n            default -> info;\\r\\n        };\\r\\n\\r\\n        executionInfoMap.put(seq, newInfo);\\r\\n        log.debug(\\\"节点状态更新: seq={}, status={}\\\", seq, newStatus);\\r\\n    }\\r\\n\\r\\n    public NodeExecutionInfo getNodeInfo(Integer seq) {\\r\\n        return executionInfoMap.get(seq);\\r\\n    }\\r\\n\\r\\n    public Collection<NodeExecutionInfo> getAllNodeInfo() {\\r\\n        return List.copyOf(executionInfoMap.values());\\r\\n    }\\r\\n\\r\\n    private List<Integer> filterNodesByStatus(Predicate<NodeExecutionInfo> predicate) {\\r\\n        return executionInfoMap.values().stream()\\r\\n                .filter(predicate)\\r\\n                .map(NodeExecutionInfo::seq)\\r\\n                .collect(Collectors.toUnmodifiableList());\\r\\n    }\\r\\n\\r\\n    public List<Integer> getCompletedNodes() {\\r\\n        return filterNodesByStatus(info -> info.status() == COMPLETED);\\r\\n    }\\r\\n\\r\\n    public List<Integer> getFailedNodes() {\\r\\n        return filterNodesByStatus(info -> info.status() == FAILED);\\r\\n    }\\r\\n\\r\\n    public boolean hasFailedNodes() {\\r\\n        return executionInfoMap.values().stream()\\r\\n                .anyMatch(info -> info.status() == FAILED);\\r\\n    }\\r\\n}\",\"error\":\"\"}",
