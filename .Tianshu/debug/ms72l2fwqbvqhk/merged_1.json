            "role": "tool",
            "content": "{\"output\":\"import re\\r\\n\\r\\nfrom pydantic import BaseModel, ConfigDict\\r\\n\\r\\nfrom app.domain.recognition import (\\r\\n    NormalizedBoundingBox,\\r\\n    NormalizedPoint,\\r\\n    RecognitionPoint,\\r\\n    VerificationStatus,\\r\\n)\\r\\nfrom app.pipeline.dimension_parser import parse_dimension\\r\\nfrom app.pipeline.geometry_associator import reading_order\\r\\nfrom app.pipeline.text_layer import TextRegion\\r\\n\\r\\n\\r\\nclass RecognitionResult(BaseModel):\\r\\n    model_config = ConfigDict(extra=\\\"forbid\\\")\\r\\n\\r\\n    points: list[RecognitionPoint]\\r\\n    warnings: list[str]\\r\\n\\r\\n\\r\\nclass MechanicalDrawingRecognizer:\\r\\n    def recognize_regions(\\r\\n        self,\\r\\n        *,\\r\\n        page_id: str,\\r\\n        regions: list[TextRegion],\\r\\n        tolerance_standard: str | None,\\r\\n        start_balloon_number: int = 1,\\r\\n    ) -> RecognitionResult:\\r\\n        regions = _merge_ocr_fragments(regions)\\r\\n        parsed_regions = []\\r\\n        warnings: list[str] = []\\r\\n        for region in reading_order(regions):\\r\\n            try:\\r\\n                parsed = parse_dimension(\\r\\n                    region.text,\\r\\n                    tolerance_standard=tolerance_standard,\\r\\n                )\\r\\n            except ValueError:\\r\\n                continue\\r\\n            parsed_regions.append((region, parsed))\\r\\n\\r\\n        points: list[RecognitionPoint] = []\\r\\n        for balloon_number, (region, parsed) in enumerate(\\r\\n            parsed_regions,\\r\\n            start=start_balloon_number,\\r\\n        ):\\r\\n            if parsed.upper_deviation is None:\\r\\n                warnings.append(\\r\\n                    f\\\"POINT_{balloon_number}_TOLERANCE_UNRESOLVED\\\"\\r\\n                )\\r\\n            points.append(\\r\\n                RecognitionPoint(\\r\\n                    id=f\\\"{page_id}:p{balloon_number}\\\",\\r\\n                    pageId=page_id,\\r\\n                    balloonNumber=balloon_number,\\r\\n                    kind=parsed.kind,\\r\\n                    rawText=parsed.raw_text,\\r\\n                    nominalValue=parsed.nominal_value,\\r\\n                    upperDeviation=parsed.upper_deviation,\\r\\n                    lowerDeviation=parsed.lower_deviation,\\r\\n                    toleranceSource=parsed.tolerance_source,\\r\\n                    unit=parsed.unit,\\r\\n                    confidence=region.confidence,\\r\\n                    verificationStatus=VerificationStatus.UNVERIFIED,\\r\\n                    bbox=region.bbox,\\r\\n                    balloonPosition=NormalizedPoint(\\r\\n                        x=min(\\r\\n                            1.0,\\r\\n                            region.bbox.x + region.bbox.width,\\r\\n                        ),\\r\\n                        y=min(\\r\\n                            1.0,\\r\\n                            region.bbox.y + region.bbox.height / 2,\\r\\n                        ),\\r\\n                    ),\\r\\n                )\\r\\n            )\\r\\n\\r\\n        return RecognitionResult(points=points, warnings=warnings)\\r\\n\\r\\n\\r\\nNOMINAL_FRAGMENT = re.compile(r\\\"^\\\\s*\\\\d+(?:\\\\.\\\\d+)?\\\\s*$\\\")\\r\\nTOLERANCE_FRAGMENT = re.compile(r\\\"^\\\\s*±\\\\s*\\\\d+(?:\\\\.\\\\d+)?\\\\s*$\\\")\\r\\n\\r\\n\\r\\ndef _merge_ocr_fragments(regions: list[TextRegion]) -> list[TextRegion]:\\r\\n    ordered = reading_order(regions)\\r\\n    consumed: set[int] = set()\\r\\n    merged: list[TextRegion] = []\\r\\n    for index, region in enumerate(ordered):\\r\\n        if index in consumed:\\r\\n            continue\\r\\n        if not NOMINAL_FRAGMENT.match(region.text):\\r\\n            merged.append(region)\\r\\n            continue\\r\\n\\r\\n        candidate_index = _adjacent_tolerance_index(\\r\\n            ordered,\\r\\n            index,\\r\\n            consumed,\\r\\n        )\\r\\n        if candidate_index is None:\\r\\n            merged.append(region)\\r\\n            continue\\r\\n\\r\\n        tolerance = ordered[candidate_index]\\r\\n        consumed.add(candidate_index)\\r\\n        left = min(region.bbox.x, tolerance.bbox.x)\\r\\n        top = min(region.bbox.y, tolerance.bbox.y)\\r\\n        right = max(\\r\\n            region.bbox.x + region.bbox.width,\\r\\n            tolerance.bbox.x + tolerance.bbox.width,\\r\\n        )\\r\\n        bottom = max(\\r\\n            region.bbox.y + region.bbox.height,\\r\\n            tolerance.bbox.y + tolerance.bbox.height,\\r\\n        )\\r\\n        merged.append(\\r\\n            TextRegion(\\r\\n                text=f\\\"{region.text.strip()} {tolerance.text.strip()}\\\",\\r\\n                confidence=min(region.confidence, tolerance.confidence),\\r\\n                source=region.source,\\r\\n                bbox=NormalizedBoundingBox(\\r\\n                    x=left,\\r\\n                    y=top,\\r\\n                    width=right - left,\\r\\n                    height=bottom - top,\\r\\n                ),\\r\\n            )\\r\\n        )\\r\\n    return reading_order(merged)\\r\\n\\r\\n\\r\\ndef _adjacent_tolerance_index(\\r\\n    regions: list[TextRegion],\\r\\n    nominal_index: int,\\r\\n    consumed: set[int],\\r\\n) -> int | None:\\r\\n    nominal = regions[nominal_index]\\r\\n    nominal_center_y = nominal.bbox.y + nominal.bbox.height / 2\\r\\n    nominal_right = nominal.bbox.x + nominal.bbox.width\\r\\n    best: tuple[float, int] | None = None\\r\\n    for index, candidate in enumerate(regions):\\r\\n        if index == nominal_index or index in consumed:\\r\\n            continue\\r\\n        if not TOLERANCE_FRAGMENT.match(candidate.text):\\r\\n            continue\\r\\n        candidate_center_y = candidate.bbox.y + candidate.bbox.height / 2\\r\\n        vertical_distance = abs(candidate_center_y - nominal_center_y)\\r\\n        horizontal_gap = candidate.bbox.x - nominal_right\\r\\n        if vertical_distance > max(\\r\\n            nominal.bbox.height,\\r\\n            candidate.bbox.height,\\r\\n        ) and abs(candidate.bbox.x - nominal.bbox.x) > max(\\r\\n            nominal.bbox.width,\\r\\n            candidate.bbox.width,\\r\\n        ):\\r\\n            continue\\r\\n        horizontal_adjacent = -0.005 <= horizontal_gap <= 0.03\\r\\n        vertical_gap = candidate.bbox.y - (\\r\\n            nominal.bbox.y + nominal.bbox.height\\r\\n        )\\r\\n        vertical_adjacent = (\\r\\n            abs(candidate.bbox.x - nominal.bbox.x) <= 0.01\\r\\n            and -0.005 <= vertical_gap <= 0.03\\r\\n        )\\r\\n        if not horizontal_adjacent and not vertical_adjacent:\\r\\n            continue\\r\\n        distance = vertical_distance + abs(horizontal_gap)\\r\\n        if best is None or distance < best[0]:\\r\\n            best = (distance, index)\\r\\n    return None if best is None else best[1]\",\"error\":\"\"}",
