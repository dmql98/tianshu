            "role": "tool",
            "content": "{\"output\":\"from typing import Literal\\r\\n\\r\\nfrom pydantic import BaseModel, ConfigDict, Field\\r\\n\\r\\nfrom app.domain.recognition import NormalizedBoundingBox\\r\\nfrom app.pipeline.pdf_document import PreparedPdfPage\\r\\n\\r\\n\\r\\nclass TextRegion(BaseModel):\\r\\n    model_config = ConfigDict(extra=\\\"forbid\\\")\\r\\n\\r\\n    text: str\\r\\n    confidence: float = Field(ge=0, le=1)\\r\\n    source: Literal[\\\"native\\\", \\\"ocr\\\"]\\r\\n    bbox: NormalizedBoundingBox\\r\\n\\r\\n\\r\\nclass TextLayerExtractor:\\r\\n    def extract(self, page: PreparedPdfPage) -> list[TextRegion]:\\r\\n        if not page.characters:\\r\\n            return []\\r\\n\\r\\n        regions: list[TextRegion] = []\\r\\n        current: list = []\\r\\n        for character in page.characters:\\r\\n            if character.value.isspace():\\r\\n                if current:\\r\\n                    regions.append(self._region_from_characters(current))\\r\\n                    current = []\\r\\n            else:\\r\\n                current.append(character)\\r\\n        if current:\\r\\n            regions.append(self._region_from_characters(current))\\r\\n        return regions\\r\\n\\r\\n    @staticmethod\\r\\n    def _region_from_characters(characters: list) -> TextRegion:\\r\\n        left = min(item.bbox.x for item in characters)\\r\\n        top = min(item.bbox.y for item in characters)\\r\\n        right = max(item.bbox.x + item.bbox.width for item in characters)\\r\\n        bottom = max(item.bbox.y + item.bbox.height for item in characters)\\r\\n        return TextRegion(\\r\\n            text=\\\"\\\".join(item.value for item in characters),\\r\\n            confidence=1.0,\\r\\n            source=\\\"native\\\",\\r\\n            bbox=NormalizedBoundingBox(\\r\\n                x=left,\\r\\n                y=top,\\r\\n                width=right - left,\\r\\n                height=bottom - top,\\r\\n            ),\\r\\n        )\"}",
