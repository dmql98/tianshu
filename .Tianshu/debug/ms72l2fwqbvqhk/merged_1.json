            "role": "tool",
            "content": "{\"output\":\"package com.industrial.registry;\\r\\n\\r\\nimport com.industrial.common.enums.ResultCode;\\r\\nimport com.industrial.common.exception.ErrorException;\\r\\nimport com.industrial.model.schema.FlowNodeDefinition;\\r\\nimport com.industrial.node.FlowNodeExecutor;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport java.util.List;\\r\\nimport java.util.Map;\\r\\nimport java.util.Set;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\n\\r\\n@Slf4j\\r\\n@Component\\r\\npublic class FlowNodeRegistry {\\r\\n\\r\\n    private final Map<String, FlowNodeExecutor> nodeRegistry = new ConcurrentHashMap<>();\\r\\n    private final Map<String, FlowNodeDefinition> nodeDefinitions = new ConcurrentHashMap<>();\\r\\n    private final Map<String, String> nodeClassNames = new ConcurrentHashMap<>();\\r\\n\\r\\n    public void register(FlowNodeExecutor executor) {\\r\\n        if (executor == null) {\\r\\n            log.warn(\\\"尝试注册空的节点执行器\\\");\\r\\n            return;\\r\\n        }\\r\\n        String nodeType = executor.getNodeType();\\r\\n        if (nodeType == null || nodeType.isEmpty()) {\\r\\n            log.warn(\\\"节点执行器 {} 未指定节点类型，跳过注册\\\", executor.getClass().getName());\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        nodeRegistry.put(nodeType, executor);\\r\\n        nodeClassNames.put(nodeType, executor.getClass().getName());\\r\\n\\r\\n        log.info(\\\"节点注册成功: type={}, class={}\\\", nodeType, executor.getClass().getName());\\r\\n    }\\r\\n\\r\\n    public void registerDefinition(FlowNodeDefinition definition) {\\r\\n        if (definition == null) {\\r\\n            log.warn(\\\"尝试注册空的节点定义\\\");\\r\\n            return;\\r\\n        }\\r\\n        String nodeType = definition.getNodeType();\\r\\n        if (nodeType == null || nodeType.isEmpty()) {\\r\\n            log.warn(\\\"节点定义 {} 未指定节点类型，跳过注册\\\", definition.getClass().getName());\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        nodeDefinitions.put(nodeType, definition);\\r\\n        log.info(\\\"节点定义注册成功: type={}, class={}\\\", nodeType, definition.getClass().getName());\\r\\n    }\\r\\n\\r\\n    public FlowNodeExecutor getNode(String nodeType) {\\r\\n        FlowNodeExecutor executor = nodeRegistry.get(nodeType);\\r\\n        if (executor == null) {\\r\\n            throw new ErrorException(ResultCode.FLOW_NODE_NOT_REGISTERED, \\\"节点类型未注册: \\\" + nodeType);\\r\\n        }\\r\\n        return executor;\\r\\n    }\\r\\n\\r\\n    public FlowNodeDefinition getNodeDefinition(String nodeType) {\\r\\n        FlowNodeDefinition definition = nodeDefinitions.get(nodeType);\\r\\n        if (definition != null) {\\r\\n            return definition;\\r\\n        }\\r\\n        FlowNodeExecutor executor = nodeRegistry.get(nodeType);\\r\\n        if (executor != null) {\\r\\n            return new ExecutorBasedDefinition(executor);\\r\\n        }\\r\\n        return null;\\r\\n    }\\r\\n\\r\\n    private record ExecutorBasedDefinition(FlowNodeExecutor executor) implements FlowNodeDefinition {\\r\\n        @Override\\r\\n        public String getNodeType() {\\r\\n            return executor.getNodeType();\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public String getNodeName() {\\r\\n            return executor.getNodeName();\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public String getCategoryTag() {\\r\\n            return executor.getCategoryTag();\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public String getCategoryName() {\\r\\n            return executor.getCategoryName();\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public String getCategoryIcon() {\\r\\n            return executor.getCategoryIcon();\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public int getMaxOutputVariables() {\\r\\n            return executor.getMaxOutputVariables();\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public List<String> getDefaultOutputVariables() {\\r\\n            return executor.getDefaultOutputVariables();\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public boolean isRegistered(String nodeType) {\\r\\n        return nodeRegistry.containsKey(nodeType);\\r\\n    }\\r\\n\\r\\n    public Set<String> getRegisteredTypes() {\\r\\n        return Set.copyOf(nodeRegistry.keySet());\\r\\n    }\\r\\n\\r\\n    public int getRegisteredCount() {\\r\\n        return nodeRegistry.size();\\r\\n    }\\r\\n\\r\\n    public String getStatusSummary() {\\r\\n        StringBuilder sb = new StringBuilder();\\r\\n        sb.append(\\\"节点注册器状态:\\\\n\\\");\\r\\n        sb.append(\\\"  已注册节点数量: \\\").append(nodeRegistry.size()).append(\\\"\\\\n\\\");\\r\\n        sb.append(\\\"  节点类型列表:\\\\n\\\");\\r\\n        nodeClassNames.forEach((type, className) ->\\r\\n            sb.append(\\\"    - \\\").append(type).append(\\\" -> \\\").append(className).append(\\\"\\\\n\\\")\\r\\n        );\\r\\n        return sb.toString();\\r\\n    }\\r\\n}\",\"error\":\"\"}",
