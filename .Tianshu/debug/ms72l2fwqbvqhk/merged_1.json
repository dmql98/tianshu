            "role": "tool",
            "content": "{\"output\":\"package com.industrial.context;\\r\\n\\r\\nimport lombok.Getter;\\r\\n\\r\\nimport java.util.Map;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\n\\r\\n@Getter\\r\\npublic class ExternalInputStore {\\r\\n\\r\\n    private final Map<String, Object> inputs = new ConcurrentHashMap<>();\\r\\n\\r\\n    public void set(String name, Object value) {\\r\\n        inputs.put(name, value);\\r\\n    }\\r\\n\\r\\n    public Object get(String name) {\\r\\n        return inputs.get(name);\\r\\n    }\\r\\n\\r\\n    public Object getOrDefault(String name, Object defaultValue) {\\r\\n        return inputs.getOrDefault(name, defaultValue);\\r\\n    }\\r\\n\\r\\n    public void putAll(Map<String, Object> inputMap) {\\r\\n        if (inputMap != null && !inputMap.isEmpty()) {\\r\\n            inputs.putAll(inputMap);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    public Map<String, Object> getAll() {\\r\\n        return Map.copyOf(inputs);\\r\\n    }\\r\\n\\r\\n    public void clear() {\\r\\n        inputs.clear();\\r\\n    }\\r\\n}\",\"error\":\"\"}",
