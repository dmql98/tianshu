            "content": "{\"output\":\"package com.industrial.config;\\r\\n\\r\\nimport com.industrial.common.enums.ResultCode;\\r\\nimport com.industrial.common.exception.ErrorException;\\r\\nimport lombok.Data;\\r\\nimport org.springframework.boot.context.properties.ConfigurationProperties;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport java.util.regex.Pattern;\\r\\n\\r\\n/**\\r\\n * 流程引擎配置类\\r\\n * 读取 application.yml 中的 app.flow 配置项\\r\\n *\\r\\n * @see AppConfig#flow\\r\\n */\\r\\n@Data\\r\\n@Component\\r\\n@ConfigurationProperties(prefix = \\\"app.flow\\\")\\r\\npublic class FlowEngineConfig {\\r\\n\\r\\n    private static final Pattern SAFE_ID_PATTERN = Pattern.compile(\\\"^[a-zA-Z0-9_-]+$\\\");\\r\\n    private static final String DATA_PATH = \\\"./data/projects\\\";\\r\\n\\r\\n    /**\\r\\n     * 获取数据根路径\\r\\n     */\\r\\n    public String getDataPath() {\\r\\n        return DATA_PATH;\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 执行记录存储路径\\r\\n     */\\r\\n    private String executionRecordPath = \\\"./data/execution-records\\\";\\r\\n\\r\\n    /**\\r\\n     * 执行记录保留天数（默认30天）\\r\\n     */\\r\\n    private int recordRetentionDays = 30;\\r\\n\\r\\n    /**\\r\\n     * 执行记录压缩年龄（小时，超过此时间未压缩的CSV将被压缩为gzip）\\r\\n     */\\r\\n    private int recordCompressionAgeHours = 24;\\r\\n\\r\\n    /**\\r\\n     * 执行记录合并阈值（每个流程超过此数量的文件时进行合并归档）\\r\\n     */\\r\\n    private int recordMaxFilesPerMerge = 10;\\r\\n\\r\\n    /**\\r\\n     * 循环执行检查间隔（毫秒）\\r\\n     */\\r\\n    private long loopCheckInterval = 5000;\\r\\n\\r\\n    /**\\r\\n     * 循环流程执行间隔（毫秒）\\r\\n     * 防止执行过快导致线程池爆炸\\r\\n     */\\r\\n    private long loopExecutionInterval = 100;\\r\\n\\r\\n    /**\\r\\n     * 执行线程池核心大小\\r\\n     */\\r\\n    private int executorCorePoolSize = 10;\\r\\n\\r\\n    /**\\r\\n     * 执行线程池最大大小\\r\\n     */\\r\\n    private int executorMaxPoolSize = 50;\\r\\n\\r\\n    /**\\r\\n     * 执行线程池队列容量\\r\\n     */\\r\\n    private int executorQueueCapacity = 1000;\\r\\n\\r\\n    /**\\r\\n     * 执行线程池空闲保活时间（秒）\\r\\n     */\\r\\n    private int executorKeepAliveSeconds = 60;\\r\\n\\r\\n    /**\\r\\n     * WebSocket推送超时时间（毫秒）\\r\\n     */\\r\\n    private long websocketPushTimeout = 5000;\\r\\n\\r\\n    /**\\r\\n     * 流程定义缓存容量上限\\r\\n     */\\r\\n    private int flowCacheMaxSize = 100;\\r\\n\\r\\n    /**\\r\\n     * 流程定义缓存TTL（分钟）\\r\\n     */\\r\\n    private int flowCacheTtlMinutes = 30;\\r\\n\\r\\n    /**\\r\\n     * 流程索引缓存容量上限\\r\\n     */\\r\\n    private int flowIndexCacheMaxSize = 50;\\r\\n\\r\\n    /**\\r\\n     * 流程索引缓存TTL（分钟）\\r\\n     */\\r\\n    private int flowIndexCacheTtlMinutes = 10;\\r\\n\\r\\n    /**\\r\\n     * 子流程同步执行超时时间（毫秒）\\r\\n     */\\r\\n    private long subflowSyncTimeoutMs = 60000;\\r\\n\\r\\n    /**\\r\\n     * 子流程完成检测间隔（毫秒）\\r\\n     */\\r\\n    private long subflowPollIntervalMs = 100;\\r\\n\\r\\n    /**\\r\\n     * 调用链最大深度限制\\r\\n     * 防止流程调用链过深导致栈溢出或线程池爆炸\\r\\n     */\\r\\n    private int maxCallChainDepth = 10;\\r\\n\\r\\n    /**\\r\\n     * 每个父流程同时调用的最大子流程数量\\r\\n     * 防止同一流程触发过多子流程导致线程池耗尽\\r\\n     */\\r\\n    private int maxConcurrentSubflowsPerFlow = 5;\\r\\n\\r\\n    /**\\r\\n     * 全局最大并发子流程数量\\r\\n     * 限制整个系统中同时执行的子流程总数\\r\\n     */\\r\\n    private int maxTotalConcurrentSubflows = 20;\\r\\n\\r\\n    /**\\r\\n     * 通知功能是否启用\\r\\n     */\\r\\n    private boolean notificationEnabled = true;\\r\\n\\r\\n    /**\\r\\n     * 是否启用文件变更自动检测\\r\\n     */\\r\\n    private boolean fileChangeDetectionEnabled = true;\\r\\n\\r\\n    /**\\r\\n     * 文件变更检测间隔（毫秒），默认5秒\\r\\n     */\\r\\n    private long fileChangeCheckIntervalMs = 5000;\\r\\n\\r\\n    /**\\r\\n     * 获取项目路径\\r\\n     */\\r\\n    public String getProjectPath(String projectId) {\\r\\n        validateId(projectId, \\\"项目ID\\\");\\r\\n        return DATA_PATH + \\\"/\\\" + projectId;\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取项目索引文件路径\\r\\n     */\\r\\n    public String getProjectIndexPath() {\\r\\n        return DATA_PATH + \\\"/project_index.json\\\";\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取流程文件路径\\r\\n     */\\r\\n    public String getFlowPath(String projectId, String flowId) {\\r\\n        validateId(projectId, \\\"项目ID\\\");\\r\\n        validateId(flowId, \\\"流程ID\\\");\\r\\n        return DATA_PATH + \\\"/\\\" + projectId + \\\"/flows/\\\" + flowId + \\\".json\\\";\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取流程索引文件路径\\r\\n     */\\r\\n    public String getFlowIndexPath(String projectId) {\\r\\n        validateId(projectId, \\\"项目ID\\\");\\r\\n        return DATA_PATH + \\\"/\\\" + projectId + \\\"/flows_index.json\\\";\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取项目信息文件路径\\r\\n     */\\r\\n    public String getProjectInfoPath(String projectId) {\\r\\n        validateId(projectId, \\\"项目ID\\\");\\r\\n        return DATA_PATH + \\\"/\\\" + projectId + \\\"/project.json\\\";\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取项目 variables 文件夹路径\\r\\n     */\\r\\n    public String getVariablesPath(String projectId) {\\r\\n        validateId(projectId, \\\"项目ID\\\");\\r\\n        return DATA_PATH + \\\"/\\\" + projectId + \\\"/variables\\\";\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 获取指定变量的文件路径\\r\\n     */\\r\\n    public static String getVariableFilePath(String projectId, String variableId) {\\r\\n        validateId(projectId, \\\"项目ID\\\");\\r\\n        validateId(variableId, \\\"变量ID\\\");\\r\\n        return DATA_PATH + \\\"/\\\" + projectId + \\\"/variables/\\\" + variableId + \\\".json\\\";\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 验证ID是否安全\\r\\n     */\\r\\n    private static void validateId(String id, String fieldName) {\\r\\n        if (id == null || id.isEmpty()) {\\r\\n            throw new ErrorException(ResultCode.VALIDATE_FAILED, fieldName + \\\"不能为空\\\");\\r\\n        }\\r\\n        if (!SAFE_ID_PATTERN.matcher(id).matches()) {\\r\\n            throw new ErrorException(ResultCode.VALIDATE_FAILED, fieldName + \\\"格式无效，只允许字母、数字、下划线和连字符\\\");\\r\\n        }\\r\\n    }\\r\\n\\r\\n}\"}",
