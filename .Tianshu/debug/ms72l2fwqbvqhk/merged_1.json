            "role": "tool",
            "content": "{\"output\":\"package com.industrial.context;\\r\\n\\r\\nimport lombok.Getter;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\n\\r\\nimport java.util.Map;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\nimport java.util.function.BiFunction;\\r\\n\\r\\n@Slf4j\\r\\n@Getter\\r\\npublic class FlowVariableCache {\\r\\n\\r\\n    private static final String FLOW_PREFIX = \\\"flow:\\\";\\r\\n    private static final String NODE_PREFIX = \\\"node:\\\";\\r\\n    private static final String VAR_PREFIX = \\\"var:\\\";\\r\\n    private static final String SEP = \\\"::\\\";\\r\\n\\r\\n    private final Map<String, Object> variables = new ConcurrentHashMap<>();\\r\\n\\r\\n    public static String makeKey(String flowId, int nodeSeq, String varName) {\\r\\n        return FLOW_PREFIX + escape(flowId) + SEP + NODE_PREFIX + nodeSeq + SEP + VAR_PREFIX + escape(varName);\\r\\n    }\\r\\n\\r\\n    private static String escape(String component) {\\r\\n        if (component == null) {\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n        return component.replace(\\\"\\\\\\\\\\\", \\\"\\\\\\\\\\\\\\\\\\\")\\r\\n                .replace(SEP, \\\"\\\\\\\\\\\" + SEP);\\r\\n    }\\r\\n\\r\\n    private static String unescape(String component) {\\r\\n        if (component == null) {\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n        StringBuilder sb = new StringBuilder();\\r\\n        for (int i = 0; i < component.length(); i++) {\\r\\n            char c = component.charAt(i);\\r\\n            if (c == '\\\\\\\\' && i + 2 < component.length()) {\\r\\n                String next2 = component.substring(i + 1, i + 3);\\r\\n                if (next2.equals(SEP)) {\\r\\n                    sb.append(SEP);\\r\\n                    i += 2;\\r\\n                    continue;\\r\\n                }\\r\\n            }\\r\\n            sb.append(c);\\r\\n        }\\r\\n        return sb.toString();\\r\\n    }\\r\\n\\r\\n    public void put(String flowId, int nodeSeq, String varName, Object value) {\\r\\n        variables.put(makeKey(flowId, nodeSeq, varName), value);\\r\\n    }\\r\\n\\r\\n    public Object get(String flowId, int nodeSeq, String varName) {\\r\\n        return variables.get(makeKey(flowId, nodeSeq, varName));\\r\\n    }\\r\\n\\r\\n    public Object getOrDefault(String flowId, int nodeSeq, String varName, Object defaultVal) {\\r\\n        return variables.getOrDefault(makeKey(flowId, nodeSeq, varName), defaultVal);\\r\\n    }\\r\\n\\r\\n    @SuppressWarnings(\\\"unchecked\\\")\\r\\n    public <T> T getAs(String flowId, int nodeSeq, String varName, Class<T> clazz) {\\r\\n        Object value = get(flowId, nodeSeq, varName);\\r\\n        if (clazz.isInstance(value)) {\\r\\n            return (T) value;\\r\\n        }\\r\\n        return null;\\r\\n    }\\r\\n\\r\\n    public void putAll(String flowId, int nodeSeq, Map<String, Object> varMap) {\\r\\n        if (varMap == null || varMap.isEmpty()) {\\r\\n            return;\\r\\n        }\\r\\n        varMap.forEach((varName, value) -> put(flowId, nodeSeq, varName, value));\\r\\n    }\\r\\n\\r\\n    public boolean contains(String flowId, int nodeSeq, String varName) {\\r\\n        return variables.containsKey(makeKey(flowId, nodeSeq, varName));\\r\\n    }\\r\\n\\r\\n    private Map<String, Object> getByPrefix(String flowId) {\\r\\n        String escapedFlowId = escape(flowId);\\r\\n        String flowPrefix = FLOW_PREFIX + escapedFlowId + SEP;\\r\\n        Map<String, Object> result = new ConcurrentHashMap<>();\\r\\n\\r\\n        variables.forEach((key, value) -> {\\r\\n            if (key.startsWith(flowPrefix)) {\\r\\n                String varName = extractVarName(key, flowPrefix);\\r\\n                if (varName != null) {\\r\\n                    result.put(varName, value);\\r\\n                }\\r\\n            }\\r\\n        });\\r\\n        return result;\\r\\n    }\\r\\n\\r\\n    private String extractVarName(String key, String flowPrefix) {\\r\\n        int nodeIndex = key.indexOf(NODE_PREFIX, flowPrefix.length());\\r\\n        if (nodeIndex < 0) {\\r\\n            return null;\\r\\n        }\\r\\n        int varIndex = key.indexOf(VAR_PREFIX, nodeIndex + NODE_PREFIX.length());\\r\\n        if (varIndex < 0) {\\r\\n            return null;\\r\\n        }\\r\\n        return unescape(key.substring(varIndex + VAR_PREFIX.length()));\\r\\n    }\\r\\n\\r\\n    public Map<String, Object> getFlowVariables(String flowId) {\\r\\n        return getByPrefix(flowId);\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 遍历指定流程的所有变量\\r\\n     */\\r\\n    public void forEachFlowVariable(String flowId, VariableVisitor visitor) {\\r\\n        String escapedFlowId = escape(flowId);\\r\\n        String flowPrefix = FLOW_PREFIX + escapedFlowId + SEP;\\r\\n        String nodePrefixBase = flowPrefix + NODE_PREFIX;\\r\\n\\r\\n        for (Map.Entry<String, Object> entry : variables.entrySet()) {\\r\\n            String key = entry.getKey();\\r\\n            if (key == null || !key.startsWith(flowPrefix)) {\\r\\n                continue;\\r\\n            }\\r\\n\\r\\n            int nodeSeqStart = key.indexOf(nodePrefixBase);\\r\\n            if (nodeSeqStart < 0) continue;\\r\\n\\r\\n            int nodeSeqEnd = key.indexOf(SEP, nodeSeqStart + nodePrefixBase.length());\\r\\n            if (nodeSeqEnd < 0) continue;\\r\\n\\r\\n            try {\\r\\n                int nodeSeq = Integer.parseInt(key.substring(nodeSeqStart + nodePrefixBase.length(), nodeSeqEnd));\\r\\n                int varPrefixIdx = key.indexOf(VAR_PREFIX, nodeSeqEnd);\\r\\n                if (varPrefixIdx < 0) continue;\\r\\n\\r\\n                String varName = unescape(key.substring(varPrefixIdx + VAR_PREFIX.length()));\\r\\n                visitor.visit(nodeSeq, varName, entry.getValue());\\r\\n            } catch (NumberFormatException ignored) {\\r\\n                // 忽略解析错误\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    @FunctionalInterface\\r\\n    public interface VariableVisitor {\\r\\n        void visit(int nodeSeq, String varName, Object value);\\r\\n    }\\r\\n\\r\\n    public Map<String, Object> getNodeVariables(String flowId, Integer nodeSeq) {\\r\\n        if (nodeSeq == null) {\\r\\n            return new ConcurrentHashMap<>();\\r\\n        }\\r\\n        String escapedFlowId = escape(flowId);\\r\\n        String nodePrefix = FLOW_PREFIX + escapedFlowId + SEP + NODE_PREFIX + nodeSeq + SEP;\\r\\n        Map<String, Object> result = new ConcurrentHashMap<>();\\r\\n\\r\\n        variables.forEach((key, value) -> {\\r\\n            if (key.startsWith(nodePrefix)) {\\r\\n                String varName = unescape(key.substring(nodePrefix.length()));\\r\\n                result.put(varName, value);\\r\\n            }\\r\\n        });\\r\\n        return result;\\r\\n    }\\r\\n\\r\\n    public void clearFlow(String flowId) {\\r\\n        String escapedFlowId = escape(flowId);\\r\\n        String prefix = FLOW_PREFIX + escapedFlowId + SEP;\\r\\n        variables.keySet().removeIf(key -> key.startsWith(prefix));\\r\\n    }\\r\\n\\r\\n    public void clearAll() {\\r\\n        variables.clear();\\r\\n    }\\r\\n\\r\\n    public int size() {\\r\\n        return variables.size();\\r\\n    }\\r\\n\\r\\n    public boolean isEmpty() {\\r\\n        return variables.isEmpty();\\r\\n    }\\r\\n}\",\"error\":\"\"}",
