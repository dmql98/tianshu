            "role": "tool",
            "content": "{\"output\":\"package com.industrial.expression;\\r\\n\\r\\nimport com.industrial.util.VariableRefPattern;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\nimport org.springframework.expression.EvaluationContext;\\r\\nimport org.springframework.expression.Expression;\\r\\nimport org.springframework.expression.ExpressionParser;\\r\\nimport org.springframework.expression.spel.standard.SpelExpressionParser;\\r\\nimport org.springframework.expression.spel.support.StandardEvaluationContext;\\r\\nimport org.springframework.stereotype.Component;\\r\\n\\r\\nimport java.util.Map;\\r\\nimport java.util.concurrent.ConcurrentHashMap;\\r\\nimport java.util.function.Function;\\r\\nimport java.util.regex.Matcher;\\r\\n\\r\\n/**\\r\\n * SpEL 表达式服务 - 封装 Spring Expression Language 表达式引擎\\r\\n * <p>\\r\\n * 特性：\\r\\n * 1. 保持与原有 ExpressionEvaluator 的变量引用格式兼容\\r\\n * 2. 支持完整的 SpEL 表达式语法\\r\\n * 3. 支持自定义变量解析器\\r\\n * 4. 支持数学运算、逻辑运算、比较运算、条件表达式等\\r\\n */\\r\\n@Slf4j\\r\\n@Component\\r\\npublic class SpELExpressionService {\\r\\n\\r\\n    private static final String UNRESOLVED_PLACEHOLDER = \\\"__UNRESOLVED__\\\";\\r\\n\\r\\n    private final ExpressionParser expressionParser;\\r\\n    private final Map<String, Expression> expressionCache;\\r\\n\\r\\n    public SpELExpressionService() {\\r\\n        this.expressionParser = new SpelExpressionParser();\\r\\n        this.expressionCache = new ConcurrentHashMap<>();\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 使用变量映射评估表达式\\r\\n     *\\r\\n     * @param expression 表达式字符串\\r\\n     * @param variables 变量名到值的映射\\r\\n     * @return 表达式结果\\r\\n     */\\r\\n    public Object evaluate(String expression, Map<String, Object> variables) {\\r\\n        if (expression == null || expression.isBlank()) {\\r\\n            return false;\\r\\n        }\\r\\n\\r\\n        String resolvedExpression = resolveReferences(expression, varRef -> variables != null ? variables.get(varRef) : null);\\r\\n        if (resolvedExpression.contains(UNRESOLVED_PLACEHOLDER)) {\\r\\n            log.debug(\\\"表达式包含未解析的变量: {}\\\", expression);\\r\\n            return false;\\r\\n        }\\r\\n\\r\\n        return evaluateSpELExpression(resolvedExpression);\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 使用自定义变量解析器评估表达式\\r\\n     *\\r\\n     * @param expression 表达式字符串\\r\\n     * @param resolver   变量解析器\\r\\n     * @return 表达式结果\\r\\n     */\\r\\n    public boolean evaluate(String expression, VariableResolver resolver) {\\r\\n        if (expression == null || expression.isBlank()) {\\r\\n            return false;\\r\\n        }\\r\\n\\r\\n        String resolved = resolveReferences(expression.trim(), resolver::resolve);\\r\\n        if (resolved.contains(UNRESOLVED_PLACEHOLDER)) {\\r\\n            log.debug(\\\"表达式包含未解析的变量: {}\\\", expression);\\r\\n            return false;\\r\\n        }\\r\\n        return evaluateBooleanExpression(resolved);\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 解析变量引用 - 通用方法\\r\\n     */\\r\\n    private String resolveReferences(String expr, Function<String, Object> resolver) {\\r\\n        Matcher matcher = VariableRefPattern.VAR_REF.matcher(expr);\\r\\n        StringBuffer sb = new StringBuffer();\\r\\n\\r\\n        while (matcher.find()) {\\r\\n            String varRef = matcher.group(1);\\r\\n            Object value = resolver.apply(varRef);\\r\\n            String replacement = value == null ? UNRESOLVED_PLACEHOLDER : Matcher.quoteReplacement(formatValue(value));\\r\\n            matcher.appendReplacement(sb, replacement);\\r\\n        }\\r\\n        matcher.appendTail(sb);\\r\\n        return sb.toString();\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 评估数学表达式\\r\\n     *\\r\\n     * @param expression 表达式字符串\\r\\n     * @param variables 变量名到值的映射\\r\\n     * @return 表达式结果（Number类型），如果表达式为空或包含未解析变量则返回null\\r\\n     */\\r\\n    public Object evaluateExpression(String expression, Map<String, Object> variables) {\\r\\n        if (expression == null || expression.isBlank()) {\\r\\n            return null;\\r\\n        }\\r\\n\\r\\n        String resolvedExpression = resolveReferences(expression, varRef -> variables != null ? variables.get(varRef) : null);\\r\\n        if (resolvedExpression.contains(UNRESOLVED_PLACEHOLDER)) {\\r\\n            log.debug(\\\"表达式包含未解析的变量: {}\\\", expression);\\r\\n            return null;\\r\\n        }\\r\\n\\r\\n        return evaluateSpELExpression(resolvedExpression);\\r\\n    }\\r\\n\\r\\n    private Object evaluateSpELExpression(String expression) {\\r\\n        try {\\r\\n            Expression exp = expressionCache.computeIfAbsent(expression, expressionParser::parseExpression);\\r\\n            EvaluationContext context = new StandardEvaluationContext();\\r\\n            return exp.getValue(context);\\r\\n        } catch (Exception e) {\\r\\n            log.warn(\\\"SpEL 表达式求值失败: expression={}, error={}\\\", expression, e.getMessage());\\r\\n            return false;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    /**\\r\\n     * 评估布尔表达式 - 兼容原有逻辑\\r\\n     */\\r\\n    private boolean evaluateBooleanExpression(String expr) {\\r\\n        String expression = expr.trim();\\r\\n\\r\\n        if (expression.contains(\\\"#{\\\") && expression.contains(\\\"}\\\")) {\\r\\n            return evaluateSpelWithPrefix(expression);\\r\\n        }\\r\\n\\r\\n        if (expression.contains(\\\" and \\\") || expression.contains(\\\" or \\\")) {\\r\\n            return evaluateLogicalExpression(expression);\\r\\n        }\\r\\n\\r\\n        if (\\\"true\\\".equalsIgnoreCase(expression)) {\\r\\n            return true;\\r\\n        }\\r\\n        if (\\\"false\\\".equalsIgnoreCase(expression)) {\\r\\n            return false;\\r\\n        }\\r\\n\\r\\n        return evaluateComparison(expression);\\r\\n    }\\r\\n\\r\\n    private boolean evaluateSpelWithPrefix(String expression) {\\r\\n        try {\\r\\n            Object result = evaluateSpELExpression(expression);\\r\\n            if (result instanceof Boolean) {\\r\\n                return (Boolean) result;\\r\\n            }\\r\\n            return result != null;\\r\\n        } catch (Exception e) {\\r\\n            log.warn(\\\"SpEL 表达式处理失败: {}\\\", e.getMessage());\\r\\n            return false;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private boolean evaluateLogicalExpression(String expr) {\\r\\n        int andIdx = expr.indexOf(\\\" and \\\");\\r\\n        if (andIdx > 0) {\\r\\n            return evaluateBooleanExpression(expr.substring(0, andIdx).trim())\\r\\n                && evaluateBooleanExpression(expr.substring(andIdx + 5).trim());\\r\\n        }\\r\\n\\r\\n        int orIdx = expr.indexOf(\\\" or \\\");\\r\\n        if (orIdx > 0) {\\r\\n            return evaluateBooleanExpression(expr.substring(0, orIdx).trim())\\r\\n                || evaluateBooleanExpression(expr.substring(orIdx + 4).trim());\\r\\n        }\\r\\n\\r\\n        return evaluateComparison(expr);\\r\\n    }\\r\\n\\r\\n    private boolean evaluateComparison(String expr) {\\r\\n        String[] ops = {\\\">=\\\", \\\"<=\\\", \\\"!=\\\", \\\"==\\\", \\\">\\\", \\\"<\\\"};\\r\\n\\r\\n        for (String op : ops) {\\r\\n            int idx = expr.indexOf(op);\\r\\n            if (idx > 0) {\\r\\n                return compareValues(expr.substring(0, idx).trim(),\\r\\n                        expr.substring(idx + op.length()).trim(), op);\\r\\n            }\\r\\n        }\\r\\n\\r\\n        return !expr.isEmpty() && !\\\"null\\\".equalsIgnoreCase(expr);\\r\\n    }\\r\\n\\r\\n    private boolean compareValues(String left, String right, String op) {\\r\\n        left = unquote(left);\\r\\n        right = unquote(right);\\r\\n\\r\\n        Double leftNum = parseNumber(left), rightNum = parseNumber(right);\\r\\n\\r\\n        if (leftNum != null && rightNum != null) {\\r\\n            int cmp = leftNum.compareTo(rightNum);\\r\\n            return switch (op) {\\r\\n                case \\\">\\\" -> cmp > 0;\\r\\n                case \\\"<\\\" -> cmp < 0;\\r\\n                case \\\">=\\\" -> cmp >= 0;\\r\\n                case \\\"<=\\\" -> cmp <= 0;\\r\\n                case \\\"==\\\" -> cmp == 0;\\r\\n                case \\\"!=\\\" -> cmp != 0;\\r\\n                default -> false;\\r\\n            };\\r\\n        }\\r\\n\\r\\n        return switch (op) {\\r\\n            case \\\"==\\\" -> left.equals(right);\\r\\n            case \\\"!=\\\" -> !left.equals(right);\\r\\n            default -> false;\\r\\n        };\\r\\n    }\\r\\n\\r\\n    private String unquote(String value) {\\r\\n        if (value == null) {\\r\\n            return null;\\r\\n        }\\r\\n        String trimmed = value.trim();\\r\\n        if (trimmed.length() >= 2) {\\r\\n            if ((trimmed.startsWith(\\\"'\\\") && trimmed.endsWith(\\\"'\\\")) ||\\r\\n                (trimmed.startsWith(\\\"\\\\\\\"\\\") && trimmed.endsWith(\\\"\\\\\\\"\\\"))) {\\r\\n                return trimmed.substring(1, trimmed.length() - 1);\\r\\n            }\\r\\n        }\\r\\n        return trimmed;\\r\\n    }\\r\\n\\r\\n    private Double parseNumber(String value) {\\r\\n        if (value == null || value.trim().isEmpty()) {\\r\\n            return null;\\r\\n        }\\r\\n        try {\\r\\n            return Double.parseDouble(value.trim());\\r\\n        } catch (NumberFormatException e) {\\r\\n            return null;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private String formatValue(Object value) {\\r\\n        if (value == null) {\\r\\n            return \\\"null\\\";\\r\\n        }\\r\\n        if (value instanceof String) {\\r\\n            return \\\"'\\\" + ((String) value).replace(\\\"'\\\", \\\"\\\\\\\\'\\\") + \\\"'\\\";\\r\\n        }\\r\\n        return value.toString();\\r\\n    }\\r\\n\\r\\n    @FunctionalInterface\\r\\n    public interface VariableResolver {\\r\\n        Object resolve(String varRef);\\r\\n    }\\r\\n}\",\"error\":\"\"}",
            "tool_call_id": "call_00_59gLfxBiznVRAH7MmSJD4119"
          },
