            "content": "{\"output\":\"from collections.abc import Callable\\r\\nimport hashlib\\r\\nfrom pathlib import Path\\r\\nfrom typing import Any\\r\\n\\r\\nfrom PIL import Image\\r\\n\\r\\nfrom app.domain.recognition import NormalizedBoundingBox\\r\\nfrom app.pipeline.text_layer import TextRegion\\r\\n\\r\\n\\r\\nclass OnnxPaddleOcrAdapter:\\r\\n    \\\"\\\"\\\"Run the bundled PaddleOCR-derived ONNX models through RapidOCR.\\\"\\\"\\\"\\r\\n\\r\\n    def __init__(\\r\\n        self,\\r\\n        engine_factory: Callable[[], Any] | None = None,\\r\\n    ) -> None:\\r\\n        self._engine_factory = engine_factory\\r\\n        self._engine: Any | None = None\\r\\n\\r\\n    def recognize(self, image_path: str | Path) -> list[TextRegion]:\\r\\n        path = Path(image_path).resolve()\\r\\n        if not path.is_file():\\r\\n            raise FileNotFoundError(f\\\"OCR image does not exist: {path}\\\")\\r\\n\\r\\n        with Image.open(path) as image:\\r\\n            image_width, image_height = image.size\\r\\n\\r\\n        result = self._get_engine()(str(path))\\r\\n        boxes = getattr(result, \\\"boxes\\\", None)\\r\\n        texts = getattr(result, \\\"txts\\\", None)\\r\\n        scores = getattr(result, \\\"scores\\\", None)\\r\\n        if boxes is None or texts is None or scores is None:\\r\\n            return []\\r\\n\\r\\n        regions: list[TextRegion] = []\\r\\n        for box, text, score in zip(boxes, texts, scores, strict=False):\\r\\n            xs = [float(point[0]) for point in box]\\r\\n            ys = [float(point[1]) for point in box]\\r\\n            left = max(0.0, min(xs) / image_width)\\r\\n            top = max(0.0, min(ys) / image_height)\\r\\n            right = min(1.0, max(xs) / image_width)\\r\\n            bottom = min(1.0, max(ys) / image_height)\\r\\n            width = right - left\\r\\n            height = bottom - top\\r\\n            if not str(text).strip() or width <= 0 or height <= 0:\\r\\n                continue\\r\\n            regions.append(\\r\\n                TextRegion(\\r\\n                    text=str(text).strip(),\\r\\n                    confidence=max(0.0, min(1.0, float(score))),\\r\\n                    source=\\\"ocr\\\",\\r\\n                    bbox=NormalizedBoundingBox(\\r\\n                        x=left,\\r\\n                        y=top,\\r\\n                        width=width,\\r\\n                        height=height,\\r\\n                    ),\\r\\n                )\\r\\n            )\\r\\n        return regions\\r\\n\\r\\n    def _get_engine(self) -> Any:\\r\\n        if self._engine is None:\\r\\n            if self._engine_factory is None:\\r\\n                import rapidocr\\r\\n                from rapidocr import RapidOCR\\r\\n\\r\\n                model_root = Path(rapidocr.__file__).resolve().parent / \\\"models\\\"\\r\\n                model_paths = {\\r\\n                    \\\"Det.model_path\\\": model_root / \\\"PP-OCRv6_det_small.onnx\\\",\\r\\n                    \\\"Cls.model_path\\\": (\\r\\n                        model_root / \\\"ch_ppocr_mobile_v2.0_cls_mobile.onnx\\\"\\r\\n                    ),\\r\\n                    \\\"Rec.model_path\\\": model_root / \\\"PP-OCRv6_rec_small.onnx\\\",\\r\\n                }\\r\\n                missing = [\\r\\n                    str(path)\\r\\n                    for path in model_paths.values()\\r\\n                    if not path.is_file()\\r\\n                ]\\r\\n                if missing:\\r\\n                    raise RuntimeError(\\r\\n                        \\\"Bundled OCR model files are missing; reinstall the \\\"\\r\\n                        f\\\"pinned RapidOCR package: {', '.join(missing)}\\\"\\r\\n                    )\\r\\n                expected_hashes = {\\r\\n                    \\\"Det.model_path\\\": (\\r\\n                        \\\"090f04abcd9d9a7498bc4ebf677e4cb9b\\\"\\r\\n                        \\\"dce1fe4197ddb7e529f1ef44e1ff94f\\\"\\r\\n                    ),\\r\\n                    \\\"Cls.model_path\\\": (\\r\\n                        \\\"e47acedf663230f8863ff1ab0e64dd2d\\\"\\r\\n                        \\\"82b838fceb5957146dab185a89d6215c\\\"\\r\\n                    ),\\r\\n                    \\\"Rec.model_path\\\": (\\r\\n                        \\\"6f327246b50388f3c176ae304bd95767\\\"\\r\\n                        \\\"ea6dc0c9ae92153ef8cbe210b3c14884\\\"\\r\\n                    ),\\r\\n                }\\r\\n                invalid = [\\r\\n                    path.name\\r\\n                    for key, path in model_paths.items()\\r\\n                    if _sha256(path) != expected_hashes[key]\\r\\n                ]\\r\\n                if invalid:\\r\\n                    raise RuntimeError(\\r\\n                        \\\"Bundled OCR model checksum mismatch: \\\"\\r\\n                        + \\\", \\\".join(invalid)\\r\\n                    )\\r\\n                self._engine = RapidOCR(\\r\\n                    params={\\r\\n                        key: str(path)\\r\\n                        for key, path in model_paths.items()\\r\\n                    }\\r\\n                )\\r\\n            else:\\r\\n                self._engine = self._engine_factory()\\r\\n        return self._engine\\r\\n\\r\\n\\r\\ndef _sha256(path: Path) -> str:\\r\\n    digest = hashlib.sha256()\\r\\n    with path.open(\\\"rb\\\") as stream:\\r\\n        for chunk in iter(lambda: stream.read(1024 * 1024), b\\\"\\\"):\\r\\n            digest.update(chunk)\\r\\n    return digest.hexdigest()\",\"error\":\"\"}",
