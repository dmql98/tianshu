            "content": "{\"output\":\"package com.industrial.util;\\r\\n\\r\\nimport com.industrial.config.FlowEngineConfig;\\r\\nimport com.industrial.constant.FlowConstants;\\r\\nimport com.alibaba.fastjson2.JSONObject;\\r\\nimport lombok.extern.slf4j.Slf4j;\\r\\n\\r\\nimport java.io.IOException;\\r\\nimport java.nio.file.Files;\\r\\nimport java.nio.file.Path;\\r\\nimport java.nio.file.Paths;\\r\\n\\r\\n@Slf4j\\r\\npublic final class VariableResolver {\\r\\n\\r\\n    private VariableResolver() {\\r\\n    }\\r\\n\\r\\n    public static Object resolve(Object valueConfig, ReferenceResolver resolver) {\\r\\n        if (valueConfig == null) {\\r\\n            return null;\\r\\n        }\\r\\n\\r\\n        if (valueConfig instanceof java.util.Map<?, ?> valueMap) {\\r\\n            @SuppressWarnings(\\\"unchecked\\\")\\r\\n            java.util.Map<String, Object> map = (java.util.Map<String, Object>) valueMap;\\r\\n            String type = TypeConvertUtil.toString(map.get(\\\"type\\\"));\\r\\n\\r\\n            return switch (type) {\\r\\n                case \\\"fixed\\\" -> map.get(\\\"fixed\\\");\\r\\n                case \\\"global\\\" -> {\\r\\n                    String globalId = TypeConvertUtil.toString(map.get(\\\"globalId\\\"));\\r\\n                    yield (globalId != null && !globalId.isEmpty())\\r\\n                            ? resolver.resolveGlobal(globalId)\\r\\n                            : null;\\r\\n                }\\r\\n                case \\\"node\\\" -> {\\r\\n                    String varRef = TypeConvertUtil.toString(map.get(\\\"var\\\"));\\r\\n                    yield (varRef != null && !varRef.isEmpty())\\r\\n                            ? resolver.resolveNode(varRef)\\r\\n                            : null;\\r\\n                }\\r\\n                default -> valueConfig;\\r\\n            };\\r\\n        }\\r\\n\\r\\n        return valueConfig;\\r\\n    }\\r\\n\\r\\n    public static Object resolveGlobalVariable(String projectId, String variableId) {\\r\\n        log.debug(\\\"[全局变量解析] projectId={}, variableId={}\\\", projectId, variableId);\\r\\n\\r\\n        Path variableFilePath = Paths.get(FlowEngineConfig.getVariableFilePath(projectId, variableId));\\r\\n\\r\\n        if (!Files.exists(variableFilePath)) {\\r\\n            log.warn(\\\"[全局变量] 变量文件不存在: {}\\\", variableFilePath);\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n\\r\\n        try {\\r\\n            String content = Files.readString(variableFilePath);\\r\\n            JSONObject varJson = JSONObject.parseObject(content);\\r\\n            return extractValue(varJson);\\r\\n        } catch (IOException e) {\\r\\n            log.error(\\\"[全局变量] 读取变量文件失败: {}, error={}\\\", variableFilePath, e.getMessage());\\r\\n            return \\\"\\\";\\r\\n        }\\r\\n    }\\r\\n\\r\\n    private static Object extractValue(JSONObject varJson) {\\r\\n        Object value = getJsonValue(varJson, FlowConstants.FIELD_CURRENT_VALUE);\\r\\n        if (TypeConvertUtil.hasValue(value)) {\\r\\n            return value;\\r\\n        }\\r\\n\\r\\n        value = getJsonValue(varJson, FlowConstants.FIELD_DEFAULT_VALUE);\\r\\n        if (TypeConvertUtil.hasValue(value)) {\\r\\n            return value;\\r\\n        }\\r\\n\\r\\n        return \\\"\\\";\\r\\n    }\\r\\n\\r\\n    private static Object getJsonValue(JSONObject json, String fieldName) {\\r\\n        if (json.containsKey(fieldName)) {\\r\\n            return json.get(fieldName);\\r\\n        }\\r\\n        return null;\\r\\n    }\\r\\n\\r\\n    public interface ReferenceResolver {\\r\\n        Object resolveGlobal(String globalId);\\r\\n        Object resolveNode(String varRef);\\r\\n    }\\r\\n\\r\\n    public static class FlowContextResolver implements ReferenceResolver {\\r\\n        private final com.industrial.context.FlowExecutionContext context;\\r\\n\\r\\n        public FlowContextResolver(com.industrial.context.FlowExecutionContext context) {\\r\\n            this.context = context;\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public Object resolveGlobal(String globalId) {\\r\\n            return context.resolveReference(\\\"global:\\\" + globalId);\\r\\n        }\\r\\n\\r\\n        @Override\\r\\n        public Object resolveNode(String varRef) {\\r\\n            return context.resolveReference(\\\"${\\\" + varRef + \\\"}\\\");\\r\\n        }\\r\\n    }\\r\\n}\",\"error\":\"\"}",
