# ── 天枢仓库根 .gitignore ──
# 策略：白名单制。默认忽略根目录所有内容，只保留应用源码、README、
# 发布脚本、精选文档与 CI 管线；本地数据（.Tianshu、配置、密钥）一律不入库。

# 默认忽略根目录下的一切
/*

# 仓库元信息与发布
!/.gitignore
!/README.md
!/publish-release.bat

# 可交付文档（其余根目录文档仍按默认规则忽略）
!/docs/
/docs/*
!/docs/客户端分发与自动更新-OpenCode实施计划.md
!/docs/跨平台客户端与Node-SQLite迁移开发指南.md

# CI 发布管线
!/.github/
/.github/*
!/.github/workflows/
!/.github/workflows/*

# 天枢源码（整个 dev/ 打开，细粒度忽略规则见 dev/.gitignore）
!/dev/
!/dev/**

# 根目录系统/编辑器杂物
.DS_Store
Thumbs.db
desktop.ini
