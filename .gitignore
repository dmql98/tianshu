# 默认忽略仓库根目录下的所有内容，只保留应用源码、运行数据和 README。
/*

# Git 配置与项目说明
!/.gitignore
!/README.md

# 天枢源码
!/dev/
!/dev/**

# 天枢本地数据
!/.Tianshu/
!/.Tianshu/**

# 本机运行状态不进入仓库
/.Tianshu/sessions.db
/.Tianshu/sessions.db-shm
/.Tianshu/sessions.db-wal

# API Key、模型服务商与本机环境配置不进入仓库
/.Tianshu/providers.json
/dev/web/server/config.json
/dev/**/.env*
!/dev/**/.env.example
!/dev/**/.env.*.example
